<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Roxa.App"
             xmlns:local="using:Roxa"
             xmlns:conv="using:Roxa.Converters"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <!-- Resources must come before Styles so that StaticResource is resolved at load time. -->
    <Application.Resources>
        <!-- Primary font. It only covers Latin and Arabic/Persian; it has no glyphs
             for Chinese, Japanese, Korean, Russian or Indic. Those glyphs are NOT
             filled in here: a comma-separated list inside FontFamily itself is
             silently ignored by Avalonia (AvaloniaUI/Avalonia#19362). The real
             substitute is FontManagerOptions.FontFallbacks in Program.BuildAvaloniaApp. -->
        <FontFamily x:Key="Vazirmatn">avares://Roxa/Assets/Fonts/Vazirmatn-Regular.ttf#Vazirmatn</FontFamily>
        <conv:BoolToOpacityConverter x:Key="BoolToOpacity"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <!-- Default font for every window.
             Previously only MainWindow had this FontFamily; the server-editor and
             QR windows were left without it and fell back to Inter — the very same empty boxes. -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{StaticResource Vazirmatn}" />
        </Style>
    </Application.Styles>
</Application>
