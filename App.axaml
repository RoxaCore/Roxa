<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Roxa.App"
             xmlns:local="using:Roxa"
             xmlns:conv="using:Roxa.Converters"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <!-- Resources باید پیش از Styles بیاید تا StaticResource در همان زمانِ بارگذاری پیدا شود. -->
    <Application.Resources>
        <!-- فونتِ اصلی. فقط لاتین و عربی/فارسی دارد؛ برایِ چینی، ژاپنی، کره‌ای، روسی و
             هندی گلیف ندارد. پُرشدنِ آن گلیف‌ها اینجا انجام نمی‌شود: لیستِ کام‌گذاری‌شده
             داخلِ خودِ FontFamily در Avalonia بی‌صدا نادیده گرفته می‌شود
             (AvaloniaUI/Avalonia#19362). جایگزینِ واقعی،
             FontManagerOptions.FontFallbacks در Program.BuildAvaloniaApp است. -->
        <FontFamily x:Key="Vazirmatn">avares://Roxa/Assets/Fonts/Vazirmatn-Regular.ttf#Vazirmatn</FontFamily>
        <conv:BoolToOpacityConverter x:Key="BoolToOpacity"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <!-- پیشفرضِ فونت برایِ همهٔ پنجره‌ها.
             قبلاً فقط MainWindow این FontFamily را داشت؛ پنجره‌هایِ ویرایشگرِ سرور و QR
             بدونِ آن می‌ماندند و به Inter می‌افتادند — یعنی همان مربع‌هایِ خالی. -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{StaticResource Vazirmatn}" />
        </Style>
    </Application.Styles>
</Application>
