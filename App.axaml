<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="XrayClient.App"
             xmlns:local="using:XrayClient"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <FontFamily x:Key="Vazirmatn">avares://XrayClient/Assets/Fonts/Vazirmatn-Regular.ttf#Vazirmatn</FontFamily>
    </Application.Resources>
</Application>
