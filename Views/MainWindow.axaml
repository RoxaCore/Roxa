<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XrayClient.ViewModels"
        xmlns:models="using:XrayClient.Models"
        xmlns:converters="using:XrayClient.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="XrayClient.Views.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainViewModel"
        Title="XrayClient" Width="900" Height="700"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI"
        Background="#F6F9F8">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <Window.Resources>
    <converters:BoolNegateConverter x:Key="Not"/>
    
    <!-- رنگ‌های تیل -->
    <SolidColorBrush x:Key="PrimaryBrush">#0E7C6B</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryDeepBrush">#0A5D50</SolidColorBrush>
    <SolidColorBrush x:Key="PrimarySoftBrush">#E1F0EC</SolidColorBrush>
    <SolidColorBrush x:Key="SuccessBrush">#0E7C6B</SolidColorBrush>
    <SolidColorBrush x:Key="WarningBrush">#C97A2B</SolidColorBrush>
    <SolidColorBrush x:Key="WarningSoftBrush">#F7E9DA</SolidColorBrush>
    <SolidColorBrush x:Key="ErrorBrush">#C4463A</SolidColorBrush>
    <SolidColorBrush x:Key="ErrorSoftBrush">#F6E1DE</SolidColorBrush>
    <SolidColorBrush x:Key="CardBackground">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="BorderLight">#E1E8E6</SolidColorBrush>
    <SolidColorBrush x:Key="TextPrimary">#122A25</SolidColorBrush>
    <SolidColorBrush x:Key="TextSecondary">#5C6E6A</SolidColorBrush>
    <SolidColorBrush x:Key="BgBrush">#F6F9F8</SolidColorBrush>

    <DataTemplate x:Key="ServerRowTemplate" DataType="models:ServerInfo">
      <Border CornerRadius="12" 
              Padding="16,14" 
              Margin="0,0,0,8"
              Background="{StaticResource CardBackground}"
              BorderBrush="{StaticResource BorderLight}"
              BorderThickness="1">
        
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" RowDefinitions="Auto" ColumnSpacing="14">
          <Grid.ContextMenu>
            <ContextMenu Padding="4">
              <MenuItem Header="اتصال" Command="{Binding Owner.ConnectServerCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsActiveConnection, Converter={StaticResource Not}}"/>
              <MenuItem Header="قطع اتصال" Command="{Binding Owner.DisconnectCommand}" IsVisible="{Binding IsActiveConnection}"/>
              <Separator/>
              <MenuItem Header="ویرایش سرور" Command="{Binding Owner.EditServerCommand}" CommandParameter="{Binding}"/>
              <MenuItem Header="کپی سرور" Command="{Binding Owner.CloneServerCommand}" CommandParameter="{Binding}"/>
              <MenuItem Header="اشتراک‌گذاری" Command="{Binding Owner.ShareServerCommand}" CommandParameter="{Binding}"/>
              <Separator/>
              <MenuItem Header="تست Ping" Command="{Binding Owner.TestOneServerCommand}" CommandParameter="{Binding}"/>
              <MenuItem Header="تست RealDelay" Command="{Binding Owner.TestOneRealDelayCommand}" CommandParameter="{Binding}"/>
              <MenuItem Header="تست سرعت" Command="{Binding Owner.TestOneSpeedCommand}" CommandParameter="{Binding}"/>
              <Separator/>
              <MenuItem Header="حذف سرور" Command="{Binding Owner.RemoveServerCommand}" CommandParameter="{Binding}" Foreground="{StaticResource ErrorBrush}"/>
            </ContextMenu>
          </Grid.ContextMenu>

          <!-- Checkbox -->
          <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center"/>

          <!-- Flag -->
          <Border Grid.Column="1" Background="{StaticResource PrimarySoftBrush}" CornerRadius="8" Width="34" Height="34">
            <TextBlock Text="{Binding Flag}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryDeepBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>

          <!-- Server Name & Details -->
          <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
              <Border Background="{StaticResource BgBrush}" CornerRadius="5" Padding="7,2">
                <TextBlock Text="{Binding ProtocolDisplay}" FontSize="10.5" FontWeight="Medium" Foreground="{StaticResource TextSecondary}"/>
              </Border>
            </StackPanel>
            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondary}" FlowDirection="LeftToRight">
              <Run Text="{Binding Address, Mode=OneWay}"/>
              <Run Text=":"/>
              <Run Text="{Binding Port, Mode=OneWay}"/>
            </TextBlock>
          </StackPanel>

          <!-- Signal Bars -->
          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2.5">
            <Border Width="4" Height="5" CornerRadius="2" Background="{StaticResource BorderLight}"/>
            <Border Width="4" Height="9" CornerRadius="2" Background="{StaticResource BorderLight}"/>
            <Border Width="4" Height="13" CornerRadius="2" Background="{StaticResource BorderLight}"/>
            <Border Width="4" Height="16" CornerRadius="2" Background="{StaticResource BorderLight}"/>
          </StackPanel>

          <!-- Ping Value -->
          <Border Grid.Column="4" CornerRadius="6" Padding="10,4" MinWidth="70" HorizontalAlignment="Center">
            <TextBlock Text="{Binding LatencyDisplay}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
          </Border>

          <!-- Action Buttons -->
          <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Border CornerRadius="8" Width="32" Height="32" Background="{StaticResource PrimaryBrush}" Cursor="Hand">
              <TextBlock Text="▶" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border CornerRadius="8" Width="32" Height="32" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Background="{StaticResource CardBackground}" Cursor="Hand">
              <TextBlock Text="✎" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border CornerRadius="8" Width="32" Height="32" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Background="{StaticResource CardBackground}" Cursor="Hand">
              <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <DockPanel Background="{StaticResource BgBrush}">
    <!-- Header -->
    <Border DockPanel.Dock="Top" Padding="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="28,0" Height="52">
        <!-- Brand -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Background="{StaticResource PrimaryBrush}" CornerRadius="9" Width="34" Height="34">
            <TextBlock Text="X" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
          </Border>
          <StackPanel Spacing="0">
            <TextBlock Text="XrayClient" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Text="مدیریت اتصال امن" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
          </StackPanel>
        </StackPanel>

        <!-- Status -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
          <Border Background="{StaticResource PrimaryBrush}" CornerRadius="8" Width="30" Height="30">
            <TextBlock Text="X" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Hero Section - Connection Status -->
    <Border DockPanel.Dock="Top" Padding="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" Margin="32,28">
        <!-- Server Info -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="وضعیت اتصال" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
          <TextBlock Text="{Binding HomeServerName}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>
          <StackPanel Orientation="Horizontal" Spacing="28">
            <StackPanel Spacing="2">
              <TextBlock Text="پینگ" FontSize="11.5" Foreground="{StaticResource TextSecondary}"/>
              <TextBlock Text="—" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock Text="دانلود" FontSize="11.5" Foreground="{StaticResource TextSecondary}"/>
              <TextBlock Text="—" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock Text="آپلود" FontSize="11.5" Foreground="{StaticResource TextSecondary}"/>
              <TextBlock Text="—" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock Text="مدت اتصال" FontSize="11.5" Foreground="{StaticResource TextSecondary}"/>
              <TextBlock Text="00:00:00" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" FlowDirection="LeftToRight"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <!-- Connect Button -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
          <Border Width="80" Height="80" CornerRadius="40" Background="{StaticResource PrimaryBrush}">
            <Border.Effect>
              <DropShadowEffect BlurRadius="20" OffsetY="8" Opacity="0.28" Color="#0E7C6B"/>
            </Border.Effect>
            <TextBlock Text="⏻" FontSize="30" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="متصل" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDeepBrush}" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Padding="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto,Auto" Margin="32,14" ColumnSpacing="10">
        <!-- Search / Add Link -->
        <Border Grid.Column="0" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Padding="12,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="🔍" FontSize="13" VerticalAlignment="Center"/>
            <TextBox Text="{Binding ServerLink}" PlaceholderText="جستجوی سرور یا افزودن لینک..." Background="Transparent" BorderThickness="0" Padding="0,8" FontSize="13" Width="300"/>
          </StackPanel>
        </Border>

        <!-- Update Button -->
        <Border Grid.Column="1" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Padding="14,8" Background="{StaticResource CardBackground}" Cursor="Hand">
          <TextBlock Text="بروزرسانی همه" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
        </Border>

        <!-- Remove Duplicates -->
        <Border Grid.Column="2" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Padding="14,8" Background="{StaticResource CardBackground}" Cursor="Hand">
          <TextBlock Text="حذف تکراری" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
        </Border>
      </Grid>
    </Border>

    <!-- Main Content -->
    <TabControl Margin="0" Padding="0" SelectedIndex="0">
      <TabControl.Styles>
        <Style Selector="TabControl">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TabItem">
          <Setter Property="FontSize" Value="13"/>
          <Setter Property="FontWeight" Value="Medium"/>
          <Setter Property="Padding" Value="16,8"/>
          <Setter Property="Margin" Value="2,0"/>
          <Setter Property="Foreground" Value="#5C6E6A"/>
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="CornerRadius" Value="9"/>
          <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TabItem:pointerover">
          <Setter Property="Background" Value="#E1F0EC"/>
          <Setter Property="Foreground" Value="#0A5D50"/>
        </Style>
        <Style Selector="TabItem:selected">
          <Setter Property="Background" Value="#E1F0EC"/>
          <Setter Property="Foreground" Value="#0A5D50"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
      </TabControl.Styles>
      
      <!-- Servers Tab (محتوای اصلی) -->
      <TabItem Padding="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
          <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:ServerGroup">
                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,16">
                  <Expander.Header>
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,4">
                      <CheckBox Grid.Column="0" IsChecked="{Binding AllServersChecked, Mode=TwoWay}" Margin="0,0,12,0"/>
                      <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="2" Text="{Binding CountText}" Opacity="0.5" FontSize="12" VerticalAlignment="Center" Margin="8,0"/>
                      <ComboBox Grid.Column="3" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding GroupSortField, Mode=TwoWay}" Width="120" Padding="6,4" FontSize="11" VerticalAlignment="Center" Margin="8,0" HorizontalAlignment="Left"/>
                      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
                        <Button Content="پینگ" Padding="8,4" Command="{Binding Owner.TestGroupCommand}" CommandParameter="{Binding}" CornerRadius="6" Background="{StaticResource PrimaryBrush}" Foreground="White" FontSize="11"/>
                        <Button Content="RealDelay" Padding="8,4" Command="{Binding Owner.TestGroupRealDelayCommand}" CommandParameter="{Binding}" CornerRadius="6" FontSize="11"/>
                        <Button Content="سرعت" Padding="8,4" Command="{Binding Owner.TestGroupSpeedCommand}" CommandParameter="{Binding}" CornerRadius="6" FontSize="11"/>
                        <Button Content="بروزرسانی" Padding="8,4" IsVisible="{Binding IsSubscription}" Command="{Binding Owner.UpdateSingleSubscriptionCommand}" CommandParameter="{Binding Subscription}" CornerRadius="6" Background="{StaticResource WarningBrush}" Foreground="White" FontSize="11"/>
                        <Button Content="حذف همه" Padding="8,4" IsVisible="{Binding IsNotSubscription}" Command="{Binding Owner.RemoveGroupServersCommand}" CommandParameter="{Binding}" CornerRadius="6" Background="{StaticResource ErrorBrush}" Foreground="White" FontSize="11"/>
                      </StackPanel>
                    </Grid>
                  </Expander.Header>
                  <ItemsControl ItemsSource="{Binding Servers}" ItemTemplate="{StaticResource ServerRowTemplate}" Margin="0,0,0,0"/>
                </Expander>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </TabItem>

      <!-- Subscriptions Tab -->
      <TabItem Header="سابسکریپشن" Padding="16">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Text="{Binding SubName}" PlaceholderText="نام" Width="150" Padding="10,8" CornerRadius="8"/>
              <TextBox Text="{Binding SubUrl}" PlaceholderText="https://..." Width="400" Padding="10,8" CornerRadius="8"/>
              <Button Content="+ افزودن" Command="{Binding AddSubscriptionCommand}" Padding="16,8" CornerRadius="8" Background="{StaticResource PrimaryBrush}" Foreground="White"/>
            </StackPanel>
            <Button Content="بروزرسانی همه" Command="{Binding UpdateSubscriptionsCommand}" Padding="12,8" CornerRadius="8"/>
          </StackPanel>
          
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Subscriptions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="10" Padding="16" Margin="0,8,0,0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text="{Binding ServerCount, StringFormat='تعداد سرورها: {0}'}" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                      </StackPanel>
                      <Button Grid.Column="1" Content="🔄" Padding="8" Margin="12,0,0,0" Command="{Binding #RootWindow.DataContext.UpdateSingleSubscriptionCommand}" CommandParameter="{Binding}"/>
                      <Button Grid.Column="2" Content="🗑️" Padding="8" Margin="8,0,0,0" Command="{Binding #RootWindow.DataContext.RemoveSubscriptionCommand}" CommandParameter="{Binding}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <!-- Log Tab -->
      <TabItem Header="لاگ" Padding="16">
        <TextBox Text="{Binding LogText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Background="{StaticResource BgBrush}" BorderThickness="0"/>
      </TabItem>

      <!-- Settings Tab -->
      <TabItem Header="تنظیمات" Padding="16">
        <ScrollViewer>
          <StackPanel Spacing="16">
            <Border CornerRadius="10" Padding="16" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="اتصال" FontWeight="Bold" FontSize="13"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox IsChecked="{Binding SetSystemProxy}" VerticalAlignment="Center"/>
                  <TextBlock Text="تنظیم پراکسی سیستم" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox IsChecked="{Binding AutoConnect}" VerticalAlignment="Center"/>
                  <TextBlock Text="اتصال خودکار" VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
            </Border>
            
            <Border CornerRadius="10" Padding="16" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="سابسکریپشن" FontWeight="Bold" FontSize="13"/>
                <TextBlock Text="بروزرسانی از طریق تب سابسکریپشن انجام می‌شود" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
              </StackPanel>
            </Border>

            <Border CornerRadius="10" Padding="16" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="تنظیمات پیشرفته" FontWeight="Bold" FontSize="13"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="نوع پینگ:" VerticalAlignment="Center"/>
                  <ComboBox ItemsSource="{Binding PingTypeOptions}" SelectedItem="{Binding SelectedPingType}" Width="160"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <TextBlock Text="XrayClient 3.0 • Avalonia" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,16,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
