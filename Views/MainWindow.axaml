<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XrayClient.ViewModels"
        xmlns:models="using:XrayClient.Models"
        xmlns:converters="using:XrayClient.Converters"
        xmlns:dg="using:Avalonia.Controls"
        xmlns:loc="using:XrayClient.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="XrayClient.Views.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainViewModel"
        Title="Roxa" Width="900" Height="700" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource Vazirmatn}"
        Background="#F8F9FA">

  <Window.Styles>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType=Button}}"/>
    </Style>
  </Window.Styles>

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <Window.Resources>
    <converters:BoolNegateConverter x:Key="Not"/>
    <converters:BoolToBrushConverter x:Key="ActiveBrush"/>
    
    <!-- رنگ‌های تیل -->
    <SolidColorBrush x:Key="PrimaryBrush">#0E7C6B</SolidColorBrush>
    <SolidColorBrush x:Key="SuccessBrush">#0E7C6B</SolidColorBrush>
    <SolidColorBrush x:Key="WarningBrush">#C97A2B</SolidColorBrush>
    <SolidColorBrush x:Key="ErrorBrush">#C4463A</SolidColorBrush>
    <SolidColorBrush x:Key="CardBackground">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="BorderLight">#E1E8E6</SolidColorBrush>
    <SolidColorBrush x:Key="TextPrimary">#122A25</SolidColorBrush>
    <SolidColorBrush x:Key="TextSecondary">#5C6E6A</SolidColorBrush>

    <DataTemplate x:Key="ServerRowTemplate" DataType="models:ServerInfo">
      <Border CornerRadius="8" 
              Padding="10,6" 
              Margin="0,2,0,0"
              HorizontalAlignment="Stretch"
              BorderThickness="1">
        <Border.Background>
          <MultiBinding Converter="{x:Static converters:ServerBgConverter.Instance}">
            <Binding Path="IsActiveConnection"/>
            <Binding Path="IsHighlighted"/>
          </MultiBinding>
        </Border.Background>
        <Border.BorderBrush>
          <MultiBinding Converter="{x:Static converters:ServerBorderConverter.Instance}">
            <Binding Path="IsActiveConnection"/>
            <Binding Path="IsHighlighted"/>
          </MultiBinding>
        </Border.BorderBrush>
        
        <Border.ContextMenu>
          <ContextMenu Padding="4">
            <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ctx_Connect}" Command="{Binding Owner.ConnectServerCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsActiveConnection, Converter={StaticResource Not}}"/>
            <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ctx_Disconnect}" Command="{Binding Owner.DisconnectCommand}" IsVisible="{Binding IsActiveConnection}"/>
            <Separator/>
            <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ctx_Edit}" Command="{Binding Owner.EditServerCommand}" CommandParameter="{Binding}"/>
            <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ctx_Clone}" Command="{Binding Owner.CloneServerCommand}" CommandParameter="{Binding}"/>
            <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ctx_Share}" Command="{Binding Owner.ShareServerCommand}" CommandParameter="{Binding}"/>
            <Separator/>
            <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ctx_TestPing}" Command="{Binding Owner.TestOneServerCommand}" CommandParameter="{Binding}"/>
            <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ctx_TestReal}" Command="{Binding Owner.TestOneRealDelayCommand}" CommandParameter="{Binding}"/>
            <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ctx_TestSpeed}" Command="{Binding Owner.TestOneSpeedCommand}" CommandParameter="{Binding}"/>
            <Separator/>
            <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ctx_Delete}" Command="{Binding Owner.RemoveServerCommand}" CommandParameter="{Binding}" Foreground="{StaticResource ErrorBrush}"/>
          </ContextMenu>
        </Border.ContextMenu>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

            <!-- Status Dot -->
            <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0" Fill="{Binding StatusColor}"/>

            <!-- Checkbox -->
            <CheckBox Grid.Column="1" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0"/>

            <!-- Flag Icon -->
            <Image Grid.Column="2" Width="24" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"
                   Source="{Binding CountryCode, Converter={x:Static converters:FlagToImageConverter.Instance}}"
                   ToolTip.Tip="{Binding ToolTipText}"/>

            <!-- Server Name + Ping/Speed on one line -->
            <TextBlock Grid.Column="3" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13" FontWeight="SemiBold" Foreground="#1A1A1A" ToolTip.Tip="{Binding ToolTipText}">
              <Run Text="{Binding ShortName, Mode=OneWay}"/>
              <Run Text="  " FontSize="10" Foreground="#AAAAAA"/>
              <Run Text="{Binding LatencyDisplay, Mode=OneWay}" FontSize="10" Foreground="#AAAAAA"/>
              <Run Text=" · " FontSize="10" Foreground="#CCCCCC"/>
              <Run Text="{Binding SpeedDisplay, Mode=OneWay}" FontSize="10" Foreground="#AAAAAA"/>
            </TextBlock>

            <!-- Action Buttons -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="8,0,0,0">
              <Button ToolTip.Tip="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Card_Connect}" Padding="6,4" Command="{Binding Owner.ConnectServerCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsActiveConnection, Converter={StaticResource Not}}" Background="Transparent" Foreground="#0E7C6B" CornerRadius="6" BorderThickness="1" BorderBrush="#D0D0D0">
                <TextBlock Text="▶" FontSize="11"/>
              </Button>
              <Button ToolTip.Tip="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Card_Disconnect}" Padding="6,4" Command="{Binding Owner.DisconnectCommand}" IsVisible="{Binding IsActiveConnection}" Background="Transparent" Foreground="#E53E3E" CornerRadius="6" BorderThickness="1" BorderBrush="#E53E3E">
                <Button.Effect>
                  <DropShadowEffect Color="#E53E3E" BlurRadius="12" Opacity="0.6" OffsetX="0" OffsetY="0"/>
                </Button.Effect>
                <TextBlock Text="✕" FontSize="24"/>
              </Button>
              <Button ToolTip.Tip="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Card_Edit}" Padding="6,4" Command="{Binding Owner.EditServerCommand}" CommandParameter="{Binding}" Background="Transparent" Foreground="#0E7C6B" CornerRadius="6" BorderThickness="1" BorderBrush="#D0D0D0">
                <TextBlock Text="✎" FontSize="11"/>
              </Button>
              <Button ToolTip.Tip="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Card_Share}" Padding="6,4" Command="{Binding Owner.ShareServerCommand}" CommandParameter="{Binding}" Background="Transparent" Foreground="#D97706" CornerRadius="6" BorderThickness="1" BorderBrush="#D0D0D0">
                <TextBlock Text="📋" FontSize="10"/>
              </Button>
              <Button ToolTip.Tip="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Card_Delete}" Padding="6,4" Command="{Binding Owner.RemoveServerCommand}" CommandParameter="{Binding}" Background="Transparent" Foreground="#E53E3E" CornerRadius="6" BorderThickness="1" BorderBrush="#D0D0D0">
                <TextBlock Text="🗑" FontSize="10"/>
              </Button>
            </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid RowDefinitions="Auto,*" Background="#F7F8FA">
    <!-- Top Bar -->
    <Border Grid.Row="0" Padding="0" Background="#FFFFFF" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
      <Border Background="#F9FAFB" CornerRadius="14" Padding="16,12" Margin="24,14,24,14" BorderBrush="#E5E7EB" BorderThickness="1" MaxWidth="500">
        <Grid ColumnDefinitions="Auto,*,Auto">

          <!-- Power Button (not connected) - Red outline -->
          <Button Grid.Column="0" Width="48" Height="48" CornerRadius="24" VerticalAlignment="Center" Margin="0,0,12,0"
                  Command="{Binding ConnectCommand}" IsVisible="{Binding IsConnected, Converter={StaticResource Not}}"
                  Background="#FFFFFF" BorderThickness="2.5" BorderBrush="#E53E3E">
            <Button.Effect>
              <DropShadowEffect Color="#E53E3E" BlurRadius="12" Opacity="0.3" OffsetX="0" OffsetY="0"/>
            </Button.Effect>
            <Viewbox Width="24" Height="24" Stretch="Uniform">
              <Canvas Width="24" Height="24">
                <Path Stroke="#E53E3E" StrokeThickness="2" StrokeLineCap="Round" Data="M12,3 L12,11"/>
                <Path Stroke="#E53E3E" StrokeThickness="2" StrokeLineCap="Round" Data="M8,13 A4.5,4.5 0 1,0 16,13"/>
              </Canvas>
            </Viewbox>
          </Button>
          <!-- Power Button (connected) - Green outline -->
          <Button Grid.Column="0" Width="48" Height="48" CornerRadius="24" VerticalAlignment="Center" Margin="0,0,12,0"
                  Command="{Binding DisconnectCommand}" IsVisible="{Binding IsConnected}"
                  Background="#FFFFFF" BorderThickness="2.5" BorderBrush="#0E7C6B">
            <Button.Effect>
              <DropShadowEffect Color="#0E7C6B" BlurRadius="12" Opacity="0.3" OffsetX="0" OffsetY="0"/>
            </Button.Effect>
            <Viewbox Width="24" Height="24" Stretch="Uniform">
              <Canvas Width="24" Height="24">
                <Path Stroke="#0E7C6B" StrokeThickness="2" StrokeLineCap="Round" Data="M12,3 L12,11"/>
                <Path Stroke="#0E7C6B" StrokeThickness="2" StrokeLineCap="Round" Data="M8,13 A4.5,4.5 0 1,0 16,13"/>
              </Canvas>
            </Viewbox>
          </Button>

          <!-- Status + Name + Speed (center) -->
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <!-- Status -->
            <TextBlock FontSize="12" FontWeight="Medium" Margin="0,0,0,2" IsVisible="{Binding IsConnected}" Foreground="#0E7C6B">
              <TextBlock.Text>
                <Binding Path="." Converter="{x:Static loc:TranslateConverter.Instance}" ConverterParameter="Card_Connected"/>
              </TextBlock.Text>
            </TextBlock>
            <TextBlock FontSize="12" FontWeight="Medium" Margin="0,0,0,2" IsVisible="{Binding IsConnected, Converter={StaticResource Not}}" Foreground="#999999">
              وصل نیستید
            </TextBlock>
            <!-- Server Name -->
            <TextBlock Text="{Binding HomeShortName}" FontSize="13" FontWeight="SemiBold" Foreground="#1A1A1A" MaxWidth="120" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" IsVisible="{Binding IsConnected}"/>
            <!-- Live Speed -->
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock FontSize="10" Foreground="#888888">
                <Run Text="↓"/>
                <Run Text="{Binding LiveDownSpeed, Mode=OneWay, FallbackValue='0 B/s'}"/>
              </TextBlock>
              <TextBlock FontSize="10" Foreground="#888888">
                <Run Text="↑"/>
                <Run Text="{Binding LiveUpSpeed, Mode=OneWay, FallbackValue='0 B/s'}"/>
              </TextBlock>
            </StackPanel>
          </StackPanel>

          <!-- Buttons (right) -->
          <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
            <!-- Smart Connect -->
            <Button Command="{Binding SmartConnectCommand}" Padding="14,8" CornerRadius="8" Background="#FFFFFF" Foreground="#0E7C6B" BorderThickness="1" BorderBrush="#D0D0D0" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="⚡" FontSize="12" FontWeight="Bold"/>
                <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_SmartConnect}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <!-- System Proxy -->
            <Button Command="{Binding ToggleSystemProxyCommand}" Padding="14,6" CornerRadius="8" FontSize="11" FontWeight="Medium" HorizontalAlignment="Right"
                    Background="{Binding SetSystemProxy, Converter={x:Static converters:BoolToBrushConverter.Instance}, ConverterParameter='#0E7C6B,#F3F4F6'}"
                    Foreground="{Binding SetSystemProxy, Converter={x:Static converters:BoolToBrushConverter.Instance}, ConverterParameter='#FFFFFF,#666666'}">
              System Proxy
            </Button>
          </StackPanel>

        </Grid>
      </Border>
    </Border>

    <!-- Tabs -->
    <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="24,0,24,0" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <TabControl.Styles>
        <Style Selector="TabControl">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TabItem">
          <Setter Property="FontSize" Value="13"/>
          <Setter Property="FontWeight" Value="Medium"/>
          <Setter Property="Padding" Value="16,10"/>
          <Setter Property="Margin" Value="0"/>
          <Setter Property="Foreground" Value="#999999"/>
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="CornerRadius" Value="0"/>
          <Setter Property="BorderThickness" Value="0,0,0,2"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TabItem:pointerover">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="Foreground" Value="#555555"/>
        </Style>
        <Style Selector="TabItem:selected">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="Foreground" Value="#0E7C6B"/>
          <Setter Property="BorderBrush" Value="#0E7C6B"/>
        </Style>
      </TabControl.Styles>
      <!-- Servers Tab -->
      <TabItem x:Name="ServersTab" Padding="16">
        <TabItem.Header>
          <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Tab_Servers}" FontSize="13" FontWeight="Medium"/>
        </TabItem.Header>
        <DockPanel>
          <!-- Filters & Add Server -->
          <Border DockPanel.Dock="Top" Padding="0,0,0,16">
            <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Text="{Binding ServerLink, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ph_ServerLink}" Width="400" Padding="12,10" BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="10" Background="#FFFFFF" FontSize="13">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding AddLinkCommand}"/>
                  </TextBox.KeyBindings>
                </TextBox>
                <Button Padding="16,10" CornerRadius="10" Background="#0E7C6B" Foreground="White" FontSize="13" FontWeight="SemiBold">
                  <Button.Flyout>
                    <MenuFlyout Placement="Bottom">
                      <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Add_Link}" Command="{Binding AddLinkCommand}"/>
                      <Separator/>
                      <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Add_VMess}" Command="{Binding AddManualServerCommand}" CommandParameter="VMess"/>
                      <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Add_VLESS}" Command="{Binding AddManualServerCommand}" CommandParameter="VLESS"/>
                      <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Add_SS}" Command="{Binding AddManualServerCommand}" CommandParameter="Shadowsocks"/>
                      <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Add_Trojan}" Command="{Binding AddManualServerCommand}" CommandParameter="Trojan"/>
                      <Separator/>
                      <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Add_Clipboard}" Command="{Binding ImportFromClipboardCommand}"/>
                    </MenuFlyout>
                  </Button.Flyout>
                  افزودن
                </Button>
                <Button Command="{Binding SmartConnectCommand}" IsVisible="{Binding ShowSmartConnectButton}" Padding="14,10" CornerRadius="10" Background="#7C3AED" Foreground="White" FontSize="13" FontWeight="SemiBold">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="⚡" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_SmartConnect}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button IsVisible="{Binding IsSmartConnecting}" IsEnabled="False" Padding="14,10" CornerRadius="10" Background="#5B21B6" Foreground="White" FontSize="13" FontWeight="SemiBold">
                  <Grid>
                    <Border Background="#7C3AED" CornerRadius="10" HorizontalAlignment="Left" RenderTransformOrigin="0,0.5">
                      <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding SearchProgressPercent}"/>
                      </Border.RenderTransform>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center" ZIndex="10">
                      <TextBlock Text="◉" VerticalAlignment="Center" FontSize="16" Foreground="White"/>
                      <TextBlock Text="{Binding SearchProgressText}" VerticalAlignment="Center" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                  </Grid>
                </Button>
                <Button Command="{Binding FindBetterServerCommand}" IsVisible="{Binding IsConnected}" IsEnabled="{Binding IsFindingBetter, Converter={StaticResource Not}}" Padding="14,10" CornerRadius="10" Background="#065F46" Foreground="White" FontSize="13" FontWeight="SemiBold" BorderThickness="0">
                  <Grid>
                    <Border Background="#0E7C6B" CornerRadius="10" HorizontalAlignment="Left" RenderTransformOrigin="0,0.5">
                      <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding SearchProgressPercent}"/>
                      </Border.RenderTransform>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center" ZIndex="10">
                      <TextBlock Text="🔍" VerticalAlignment="Center" IsVisible="{Binding IsFindingBetter, Converter={StaticResource Not}}"/>
                      <TextBlock Text="◉" VerticalAlignment="Center" FontSize="16" IsVisible="{Binding IsFindingBetter}" Foreground="White"/>
                      <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_FindBetter}" VerticalAlignment="Center" IsVisible="{Binding IsFindingBetter, Converter={StaticResource Not}}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding SearchProgressText}" VerticalAlignment="Center" IsVisible="{Binding IsFindingBetter}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                  </Grid>
                </Button>
              </StackPanel>
              
              <!-- Action Buttons -->
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_PingAll}" Command="{Binding TestAllCommand}" IsVisible="{Binding IsTesting, Converter={StaticResource Not}}" Padding="12,8" CornerRadius="8" Background="#F5F5F5" Foreground="#555555" FontSize="12" BorderThickness="0"/>
                <Button Content="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_Stop}" Command="{Binding StopTestCommand}" IsVisible="{Binding IsTesting}" Padding="12,8" CornerRadius="8" Background="#FFF5F5" Foreground="#E53E3E" FontSize="12" BorderThickness="0"/>
                <Button Content="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_Real}" Command="{Binding TestRealDelayAllCommand}" IsVisible="{Binding IsTesting, Converter={StaticResource Not}}" Padding="12,8" CornerRadius="8" Background="#F5F5F5" Foreground="#555555" FontSize="12" BorderThickness="0"/>
                <Button Content="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_SpeedAll}" Command="{Binding TestSpeedCommand}" IsVisible="{Binding IsTesting, Converter={StaticResource Not}}" Padding="12,8" CornerRadius="8" Background="#F5F5F5" Foreground="#555555" FontSize="12" BorderThickness="0"/>
                <Button Content="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_RemoveDupes}" Command="{Binding RemoveDuplicatesCommand}" Padding="12,8" CornerRadius="8" Background="#FFF5F5" Foreground="#E53E3E" FontSize="12" BorderThickness="0"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Servers List -->
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}">
              <ItemsControl.Styles>
                <Style Selector="ContentPresenter">
                  <Setter Property="HorizontalAlignment" Value="Stretch"/>
                </Style>
              </ItemsControl.Styles>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ServerGroup">
                  <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                    <Expander.Header>
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,4">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <CheckBox IsChecked="{Binding AllServersChecked, Mode=TwoWay}"/>
                          <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding CountText}" Opacity="0.5" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <StackPanel Orientation="Vertical" Spacing="2" IsVisible="{Binding IsSubscription}" MinWidth="200">
                            <Grid ColumnDefinitions="*" Margin="0,0,0,2">
                              <Border CornerRadius="4" Height="8" Background="#E0E0E0" ClipToBounds="True" HorizontalAlignment="Stretch">
                                <Border CornerRadius="4" Height="8" Background="#2FC1A6" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                                  <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding Subscription.TrafficPercent}"/>
                                  </Border.RenderTransform>
                                </Border>
                              </Border>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="{Binding Subscription.TrafficDisplay}" FontSize="10" Foreground="#666666" VerticalAlignment="Center"/>
                              <TextBlock Grid.Column="1" Text="{Binding Subscription.ExpireText}" FontSize="10" Foreground="#666666" VerticalAlignment="Center"/>
                            </Grid>
                          </StackPanel>
                          <Button Content="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_Ping}" Padding="8,4" Command="{Binding Owner.TestGroupCommand}" CommandParameter="{Binding}" CornerRadius="6" Background="#F5F5F5" Foreground="#555555" FontSize="11" BorderThickness="0"/>
                          <Button Content="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_Real}" Padding="8,4" Command="{Binding Owner.TestGroupRealDelayCommand}" CommandParameter="{Binding}" CornerRadius="6" Background="#F5F5F5" Foreground="#555555" FontSize="11" BorderThickness="0"/>
                          <Button Content="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_Speed}" Padding="8,4" Command="{Binding Owner.TestGroupSpeedCommand}" CommandParameter="{Binding}" CornerRadius="6" Background="#F5F5F5" Foreground="#555555" FontSize="11" BorderThickness="0"/>
                          <Button Content="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_UpdateAll}" Padding="8,4" IsVisible="{Binding IsAllGroup}" Command="{Binding Owner.UpdateSubscriptionsCommand}" CornerRadius="6" Background="#FFF3E0" Foreground="#E65100" FontSize="11" BorderThickness="0"/>
                          <Button Content="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_Update}" Padding="8,4" IsVisible="{Binding IsSubscription}" Command="{Binding Owner.UpdateSingleSubscriptionCommand}" CommandParameter="{Binding Subscription}" CornerRadius="6" Background="#FFF3E0" Foreground="#E65100" FontSize="11" BorderThickness="0"/>
                          <Button Content="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_Update}" Padding="8,4" IsVisible="{Binding IsManualGroup}" Command="{Binding Owner.UpdateGroupServersCommand}" CommandParameter="{Binding}" CornerRadius="6" Background="#FFF3E0" Foreground="#E65100" FontSize="11" BorderThickness="0"/>
                          <Button Content="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_RemoveSub}" Padding="8,4" IsVisible="{Binding IsSubscription}" Command="{Binding Owner.RemoveSubscriptionCommand}" CommandParameter="{Binding Subscription}" CornerRadius="6" Background="#FFF5F5" Foreground="#E53E3E" FontSize="11" BorderThickness="0"/>
                          <Button Content="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_RemoveAll}" Padding="8,4" IsVisible="{Binding IsManualGroup}" Command="{Binding Owner.RemoveGroupServersCommand}" CommandParameter="{Binding}" CornerRadius="6" Background="#FFF5F5" Foreground="#E53E3E" FontSize="11" BorderThickness="0"/>
                        </StackPanel>
                        <ComboBox Grid.Column="3" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding GroupSortField, Mode=TwoWay}" Width="110" Padding="4,3" FontSize="10" VerticalAlignment="Center"/>
                      </Grid>
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding Servers}" ItemTemplate="{StaticResource ServerRowTemplate}" Margin="0,0,0,0">
                      <ItemsControl.Styles>
                        <Style Selector="ContentPresenter">
                          <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        </Style>
                      </ItemsControl.Styles>
                    </ItemsControl>
                  </Expander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <!-- Subscriptions Tab -->
      <TabItem Padding="16">
        <TabItem.Header>
          <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Tab_Subscription}" FontSize="13" FontWeight="Medium"/>
        </TabItem.Header>
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Text="{Binding SubName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ph_SubName}" Width="150" Padding="10,8" CornerRadius="6"/>
              <TextBox Text="{Binding SubUrl, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="https://..." Width="400" Padding="10,8" CornerRadius="6"/>
              <Button Content="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_Add}" Command="{Binding AddSubscriptionCommand}" Padding="16,8" CornerRadius="6" Background="{StaticResource PrimaryBrush}" Foreground="White"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Content="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_UpdateAll}" Command="{Binding UpdateSubscriptionsCommand}" Padding="12,8" CornerRadius="6"/>
              <CheckBox Content="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Sub_UseProxy}" IsChecked="{Binding UseProxyForSubscriptions}" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
          </StackPanel>
          
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Subscriptions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="6" Padding="16" Margin="0,8,0,0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Cursor="Hand" Tag="{Binding Name}" PointerPressed="SubscriptionCard_PointerPressed">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text="{Binding ServerCount, StringFormat='تعداد سرورها: {0}'}" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding TrafficDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                          <TextBlock Text="{Binding TrafficDisplay}" FontSize="11" Foreground="#666666"/>
                          <TextBlock Text="{Binding ExpireText}" FontSize="11" Foreground="#666666"/>
                        </StackPanel>
                        <Border CornerRadius="2" Height="4" Background="#E0E0E0" ClipToBounds="True" IsVisible="{Binding TrafficDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Margin="0,2,0,0">
                          <Border CornerRadius="2" Height="4" Background="#2FC1A6" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                              <ScaleTransform ScaleX="{Binding TrafficPercent}"/>
                            </Border.RenderTransform>
                          </Border>
                        </Border>
                      </StackPanel>
                      <Button Grid.Column="1" Content="🔄" Padding="8" Margin="12,0,0,0" Command="{Binding #RootWindow.DataContext.UpdateSingleSubscriptionCommand}" CommandParameter="{Binding}"/>
                      <Button Grid.Column="2" Content="🗑️" Padding="8" Margin="8,0,0,0" Command="{Binding #RootWindow.DataContext.RemoveSubscriptionCommand}" CommandParameter="{Binding}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <!-- Log Tab -->
      <TabItem Padding="16">
        <TabItem.Header>
          <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Tab_Log}" FontSize="13" FontWeight="Medium"/>
        </TabItem.Header>
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Filter_Label}" VerticalAlignment="Center" FontSize="12" Foreground="#888"/>
            <ComboBox ItemsSource="{Binding LogFilters}" SelectedItem="{Binding LogFilter}" Width="130" Padding="4,3" FontSize="12"/>
          </StackPanel>
          <TextBox Text="{Binding FilteredLogText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Background="#F5F5F5" BorderThickness="0"/>
        </DockPanel>
      </TabItem>

      <!-- Settings Tab -->
      <TabItem Padding="16">
        <TabItem.Header>
          <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Tab_Settings}" FontSize="13" FontWeight="Medium"/>
        </TabItem.Header>
        <ScrollViewer>
          <StackPanel Spacing="16">
            <Border CornerRadius="6" Padding="16" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_Connection}" FontWeight="Bold" FontSize="13"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <RadioButton GroupName="ProxyMode" IsChecked="{Binding SetSystemProxy}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_Proxy}" VerticalAlignment="Center" Opacity="{Binding LeaveSystemProxyAsIs, Converter={StaticResource BoolToOpacity}}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <RadioButton GroupName="ProxyMode" IsChecked="{Binding LeaveSystemProxyAsIs}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_LeaveProxy}" VerticalAlignment="Center" Opacity="{Binding SetSystemProxy, Converter={StaticResource BoolToOpacity}}"/>
                </StackPanel>
                <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_LeaveProxy_Desc}" FontSize="11" Foreground="#888888" Margin="24,0,0,0"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox IsChecked="{Binding ClearProxyOnDisconnect}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_ClearProxy}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_ClearProxy_Desc}" FontSize="11" Foreground="#888888" Margin="24,0,0,0"/>
              </StackPanel>
            </Border>
            
            <Border CornerRadius="6" Padding="16" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_SubscriptionUpdate}" FontWeight="Bold" FontSize="13"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox IsChecked="{Binding AutoUpdateSubs}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_AutoUpdate}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding AutoUpdateSubs}">
                  <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_Every}" VerticalAlignment="Center"/>
                  <TextBox Text="{Binding AutoUpdateIntervalHours}" Width="60" Padding="6,4" HorizontalContentAlignment="Center"/>
                  <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_Hours}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding LastUpdateDisplay}" FontSize="11" Foreground="{StaticResource TextSecondary}" IsVisible="{Binding AutoUpdateSubs}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox IsChecked="{Binding AutoConnect}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_AutoConnect}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_AutoConnect_Desc}" FontSize="11" Foreground="#888888" Margin="24,0,0,0"/>
              </StackPanel>
            </Border>

            <Border CornerRadius="6" Padding="16" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_Advanced}" FontWeight="Bold" FontSize="13"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_PingType}" VerticalAlignment="Center"/>
                  <ComboBox ItemsSource="{Binding PingTypeOptions}" SelectedItem="{Binding SelectedPingType}" Width="160"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox IsChecked="{Binding GlobalSort}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_GlobalSort}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border CornerRadius="6" Padding="16" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_DNS}" FontWeight="Bold" FontSize="13"/>
                <Button Content="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_DNSBtn}" Padding="16,10" CornerRadius="8" Background="#0E7C6B" Foreground="White" FontSize="13" FontWeight="SemiBold" Command="{Binding OpenDnsSettingsCommand}"/>
              </StackPanel>
            </Border>

            <Border CornerRadius="6" Padding="16" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <ToggleSwitch IsChecked="{Binding UseTunMode}"/>
                  <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_TUN}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_TUN_Desc}" FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <Border CornerRadius="6" Padding="16" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_Language}" FontWeight="Bold" FontSize="13"/>
                <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}" Width="160" Padding="4,4" FontSize="13"/>
              </StackPanel>
            </Border>

            <TextBlock Text="Roxa 3.0 • Avalonia" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,16,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <!-- Toast Notification -->
    <Border x:Name="ToastBorder" IsVisible="False" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,80,0,0" ZIndex="100"
            Background="#122A25" CornerRadius="10" Padding="20,12" MaxWidth="400">
      <TextBlock x:Name="ToastText" Text="" FontSize="13" Foreground="White" TextWrapping="Wrap" TextAlignment="Center"/>
    </Border>
  </Grid>
</Window>
