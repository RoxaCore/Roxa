<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Roxa.ViewModels"
        xmlns:models="using:Roxa.Models"
        xmlns:converters="using:Roxa.Converters"
        xmlns:dg="using:Avalonia.Controls"
        xmlns:loc="using:Roxa.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="Roxa.Views.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainViewModel"
        Title="Roxa" Width="900" Height="700" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource Vazirmatn}"
        Background="#F8F9FA">

  <Window.Styles>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType=Button}}"/>
    </Style>
  </Window.Styles>

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <Window.Resources>
    <converters:BoolNegateConverter x:Key="Not"/>
    <converters:BoolToBrushConverter x:Key="ActiveBrush"/>
    <SolidColorBrush x:Key="PrimaryBrush">#0E7C6B</SolidColorBrush>
    <SolidColorBrush x:Key="SuccessBrush">#0E7C6B</SolidColorBrush>
    <SolidColorBrush x:Key="WarningBrush">#C97A2B</SolidColorBrush>
    <SolidColorBrush x:Key="ErrorBrush">#C4463A</SolidColorBrush>
    <SolidColorBrush x:Key="CardBackground">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="BorderLight">#E1E8E6</SolidColorBrush>
    <SolidColorBrush x:Key="TextPrimary">#122A25</SolidColorBrush>
    <SolidColorBrush x:Key="TextSecondary">#5C6E6A</SolidColorBrush>

    <ContextMenu x:Key="ServerRowContextMenu" x:DataType="models:ServerInfo" Padding="4">
      <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ctx_Connect}" Command="{Binding Owner.ConnectServerCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsActiveConnection, Converter={StaticResource Not}}"/>
      <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ctx_Disconnect}" Command="{Binding Owner.DisconnectCommand}" IsVisible="{Binding IsActiveConnection}"/>
      <Separator/>
      <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ctx_Edit}" Command="{Binding Owner.EditServerCommand}" CommandParameter="{Binding}"/>
      <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ctx_Clone}" Command="{Binding Owner.CloneServerCommand}" CommandParameter="{Binding}"/>
      <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ctx_Share}" Command="{Binding Owner.ShareServerCommand}" CommandParameter="{Binding}"/>
      <Separator/>
      <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ctx_TestPing}" Command="{Binding Owner.TestOneServerCommand}" CommandParameter="{Binding}"/>
      <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ctx_TestReal}" Command="{Binding Owner.TestOneRealDelayCommand}" CommandParameter="{Binding}"/>
      <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ctx_TestSpeed}" Command="{Binding Owner.TestOneSpeedCommand}" CommandParameter="{Binding}"/>
      <Separator/>
      <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ctx_Delete}" Command="{Binding Owner.RemoveServerCommand}" CommandParameter="{Binding}" Foreground="{StaticResource ErrorBrush}"/>
    </ContextMenu>

    <ContextMenu x:Key="MultiServerContextMenu" x:DataType="models:ServerInfo" Padding="4">
      <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ctx_TestPing}" Command="{Binding Owner.TestSelectedCommand}"/>
      <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ctx_TestReal}" Command="{Binding Owner.TestRealDelaySelectedCommand}"/>
      <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ctx_TestSpeed}" Command="{Binding Owner.TestSelectedSpeedCommand}"/>
      <Separator/>
      <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ctx_Delete}" Command="{Binding Owner.RemoveSelectedCommand}" Foreground="{StaticResource ErrorBrush}"/>
      <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ctx_ClearSel}" Command="{Binding Owner.ClearSelectionCommand}"/>
    </ContextMenu>
  </Window.Resources>

  <Grid RowDefinitions="Auto,Auto,*" Background="#F7F8FA">
    <!-- Top Bar -->
    <Border Grid.Row="0" Padding="0" Background="#FFFFFF" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
      <Border Background="#F9FAFB" CornerRadius="14" Padding="38,12" Margin="38,14,38,14" BorderBrush="#E5E7EB" BorderThickness="1">
        <Grid ColumnDefinitions="Auto,*,Auto">

          <!-- Power Button (not connected) - Red outline -->
          <Button Grid.Column="0" Width="48" Height="48" CornerRadius="24" VerticalAlignment="Center" Margin="0,0,12,0"
                  Command="{Binding ConnectCommand}" IsVisible="{Binding IsConnected, Converter={StaticResource Not}}"
                  AutomationProperties.Name="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ctx_Connect}"
                  Background="#FFFFFF" BorderThickness="2.5" BorderBrush="#E53E3E">
            <Button.Effect>
              <DropShadowEffect Color="#E53E3E" BlurRadius="12" Opacity="0.3" OffsetX="0" OffsetY="0"/>
            </Button.Effect>
            <Viewbox Width="31" Height="31" Stretch="Uniform">
              <Canvas Width="24" Height="24">
                <Path Stroke="#E53E3E" StrokeThickness="2" StrokeLineCap="Round" Data="M12,3 L12,11"/>
                <Path Stroke="#E53E3E" StrokeThickness="2" StrokeLineCap="Round" Data="M8,13 A4.5,4.5 0 1,0 16,13"/>
              </Canvas>
            </Viewbox>
          </Button>
          <!-- Power Button (connected) - Green outline -->
          <Button Grid.Column="0" Width="48" Height="48" CornerRadius="24" VerticalAlignment="Center" Margin="0,0,12,0"
                  Command="{Binding DisconnectCommand}" IsVisible="{Binding IsConnected}"
                  AutomationProperties.Name="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ctx_Disconnect}"
                  Background="#FFFFFF" BorderThickness="2.5" BorderBrush="#0E7C6B">
            <Button.Effect>
              <DropShadowEffect Color="#0E7C6B" BlurRadius="12" Opacity="0.3" OffsetX="0" OffsetY="0"/>
            </Button.Effect>
            <Viewbox Width="31" Height="31" Stretch="Uniform">
              <Canvas Width="24" Height="24">
                <Path Stroke="#0E7C6B" StrokeThickness="2" StrokeLineCap="Round" Data="M12,3 L12,11"/>
                <Path Stroke="#0E7C6B" StrokeThickness="2" StrokeLineCap="Round" Data="M8,13 A4.5,4.5 0 1,0 16,13"/>
              </Canvas>
            </Viewbox>
          </Button>

          <!-- Status + Name + Speed (center) -->
          <StackPanel Grid.Column="1" VerticalAlignment="Center" RenderTransformOrigin="0,0.5">
            <StackPanel.RenderTransform>
              <ScaleTransform ScaleX="1.3" ScaleY="1.3"/>
            </StackPanel.RenderTransform>
            <!-- Status (always visible) -->
            <TextBlock FontSize="12" FontWeight="Medium" Margin="0,0,0,2" IsVisible="{Binding IsConnected}" Foreground="#0E7C6B">
              <TextBlock.Text>
                <Binding Path="." Converter="{x:Static loc:TranslateConverter.Instance}" ConverterParameter="Card_Connected"/>
              </TextBlock.Text>
            </TextBlock>
            <TextBlock FontSize="12" FontWeight="Medium" Margin="0,0,0,2" IsVisible="{Binding IsConnected, Converter={StaticResource Not}}" Foreground="#E53E3E">
              <TextBlock.Text>
                <Binding Path="." Converter="{x:Static loc:TranslateConverter.Instance}" ConverterParameter="Home_NotConnected"/>
              </TextBlock.Text>
            </TextBlock>
            <!-- Server Name (when connected) -->
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,2" IsVisible="{Binding IsConnected}">
              <TextBlock Text="{Binding HomeProtocol}" FontSize="11" FontWeight="SemiBold" Foreground="#7C3AED" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding HomeShortName}" FontSize="13" FontWeight="SemiBold" Foreground="#1A1A1A" MaxWidth="120" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding HomeIp}" FontSize="11" Foreground="#888888" VerticalAlignment="Center"/>
            </StackPanel>
            <!-- Live Speed (always visible) -->
            <StackPanel Orientation="Horizontal" Spacing="10" Opacity="{Binding SpeedBlinkOpacity}">
              <TextBlock FontSize="10" Foreground="{Binding IsConnected, Converter={x:Static converters:BoolToBrushConverter.Instance}, ConverterParameter='#0E7C6B,#888888'}">
                <Run Text="↓"/>
                <Run Text="{Binding LiveDownSpeed, Mode=OneWay, FallbackValue='0 B/s'}"/>
              </TextBlock>
              <TextBlock FontSize="10" Foreground="{Binding IsConnected, Converter={x:Static converters:BoolToBrushConverter.Instance}, ConverterParameter='#0E7C6B,#888888'}">
                <Run Text="↑"/>
                <Run Text="{Binding LiveUpSpeed, Mode=OneWay, FallbackValue='0 B/s'}"/>
              </TextBlock>
            </StackPanel>
          </StackPanel>

          <!-- Buttons (right) -->
          <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
            <!-- Smart Connect / Find Better (unified) -->
            <Button Command="{Binding SmartConnectActionCommand}" IsEnabled="{Binding IsFindingBetter, Converter={StaticResource Not}}"
                    AutomationProperties.Name="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_SmartConnect}"
                    Padding="16,10" CornerRadius="10" Background="#7C3AED" Foreground="White" FontSize="13" FontWeight="SemiBold" BorderThickness="0">
              <Grid ClipToBounds="True">
                <Border Background="#5B21B6" HorizontalAlignment="Left" RenderTransformOrigin="0,0.5" IsVisible="{Binding IsSmartConnecting}">
                  <Border.RenderTransform>
                    <ScaleTransform ScaleX="{Binding SearchProgressPercent}"/>
                  </Border.RenderTransform>
                </Border>
                <Border Background="#5B21B6" HorizontalAlignment="Left" RenderTransformOrigin="0,0.5" IsVisible="{Binding IsFindingBetter}">
                  <Border.RenderTransform>
                    <ScaleTransform ScaleX="{Binding SearchProgressPercent}"/>
                  </Border.RenderTransform>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center" ZIndex="10" IsVisible="{Binding ShowSmartConnectButton}">
                  <TextBlock Text="⚡" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_SmartConnect}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center" ZIndex="10" IsVisible="{Binding IsSmartConnecting}">
                  <TextBlock Text="◉" FontSize="14" Foreground="White"/>
                  <TextBlock Text="{Binding SearchProgressText}" Foreground="White" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center" ZIndex="10" IsVisible="{Binding IsConnected}">
                  <TextBlock Text="🔍" IsVisible="{Binding IsFindingBetter, Converter={StaticResource Not}}"/>
                  <TextBlock Text="◉" FontSize="14" IsVisible="{Binding IsFindingBetter}" Foreground="White"/>
                  <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_FindBetter}" IsVisible="{Binding IsFindingBetter, Converter={StaticResource Not}}" Foreground="White" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding SearchProgressText}" IsVisible="{Binding IsFindingBetter}" Foreground="White" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Grid>
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
              <!-- System Proxy -->
              <Button Command="{Binding ToggleSystemProxyCommand}" Padding="14,6" CornerRadius="8" FontSize="11" FontWeight="Medium"
                      Background="{Binding SetSystemProxy, Converter={x:Static converters:BoolToBrushConverter.Instance}, ConverterParameter='#0E7C6B,#F3F4F6'}"
                      Foreground="{Binding SetSystemProxy, Converter={x:Static converters:BoolToBrushConverter.Instance}, ConverterParameter='#FFFFFF,#666666'}">
                <TextBlock Text="{Binding SetSystemProxy, Converter={x:Static converters:BoolToStatusTextConverter.Instance}, ConverterParameter='Proxy_On,Proxy_Off'}"/>
              </Button>
              <!-- TUN -->
              <Button Command="{Binding ToggleTunCommand}" Padding="14,6" CornerRadius="8" FontSize="11" FontWeight="Medium"
                      Background="{Binding UseTunMode, Converter={x:Static converters:BoolToBrushConverter.Instance}, ConverterParameter='#7C3AED,#F3F4F6'}"
                      Foreground="{Binding UseTunMode, Converter={x:Static converters:BoolToBrushConverter.Instance}, ConverterParameter='#FFFFFF,#666666'}">
                <TextBlock Text="{Binding UseTunMode, Converter={x:Static converters:BoolToStatusTextConverter.Instance}, ConverterParameter='Tun_On,Tun_Off'}"/>
              </Button>
            </StackPanel>
          </StackPanel>

        </Grid>
      </Border>
    </Border>

    <!-- Remote Banners -->
    <StackPanel Grid.Row="1" Margin="38,0,38,10" Spacing="8">
      <Border IsVisible="{Binding IsBannerVisible}"
              Background="{Binding BannerBackground}" CornerRadius="10" Padding="16,10"
              BorderBrush="{Binding BannerForeground}" BorderThickness="1">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Vertical" Spacing="2" Grid.Column="0">
            <TextBlock Text="{Binding BannerTitle}" FontWeight="SemiBold" FontSize="13"
                       Foreground="{Binding BannerForeground}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding BannerBody}" FontSize="12" Foreground="{Binding BannerForeground}" Opacity="0.85"
                       TextWrapping="Wrap" IsVisible="{Binding BannerBody, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="14,0,0,0">
            <Button Content="{Binding BannerActionText}" IsVisible="{Binding BannerHasAction}"
                    IsEnabled="{Binding IsBannerBusy, Converter={StaticResource Not}}"
                    Command="{Binding BannerActionCommand}" Padding="14,6" CornerRadius="8" FontSize="12" FontWeight="SemiBold"
                    Background="{Binding BannerForeground}" Foreground="White"/>
            <Button Command="{Binding DismissBannerCommand}"
                    IsEnabled="{Binding IsBannerBusy, Converter={StaticResource Not}}"
                    Padding="14,6" CornerRadius="8" FontSize="12"
                    Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1"
                    Foreground="{Binding BannerForeground}">
              <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ann_Dismiss}"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Border IsVisible="{Binding IsAnnBannerVisible}"
              Background="{Binding AnnBannerBackground}" CornerRadius="10" Padding="16,10"
              BorderBrush="{Binding AnnBannerForeground}" BorderThickness="1">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Vertical" Spacing="2" Grid.Column="0">
            <TextBlock Text="{Binding AnnBannerTitle}" FontWeight="SemiBold" FontSize="13"
                       Foreground="{Binding AnnBannerForeground}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding AnnBannerBody}" FontSize="12" Foreground="{Binding AnnBannerForeground}" Opacity="0.85"
                       TextWrapping="Wrap" IsVisible="{Binding AnnBannerBody, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="14,0,0,0">
            <Button Content="{Binding AnnBannerActionText}" IsVisible="{Binding AnnBannerHasAction}"
                    Command="{Binding AnnBannerActionCommand}" Padding="14,6" CornerRadius="8" FontSize="12" FontWeight="SemiBold"
                    Background="{Binding AnnBannerForeground}" Foreground="White"/>
            <Button Command="{Binding AnnDismissCommand}"
                    Padding="14,6" CornerRadius="8" FontSize="12"
                    Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1"
                    Foreground="{Binding AnnBannerForeground}">
              <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ann_Dismiss}"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>

    <!-- Tabs -->
    <TabControl x:Name="MainTabControl" Grid.Row="2" Margin="24,0,24,0" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <TabControl.Styles>
        <Style Selector="TabControl">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TabItem">
          <Setter Property="FontSize" Value="13"/>
          <Setter Property="FontWeight" Value="Medium"/>
          <Setter Property="Padding" Value="16,10"/>
          <Setter Property="Margin" Value="0"/>
          <Setter Property="Foreground" Value="#999999"/>
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="CornerRadius" Value="0"/>
          <Setter Property="BorderThickness" Value="0,0,0,2"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TabItem:pointerover">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="Foreground" Value="#555555"/>
        </Style>
        <Style Selector="TabItem:selected">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="Foreground" Value="#0E7C6B"/>
          <Setter Property="BorderBrush" Value="#0E7C6B"/>
        </Style>
      </TabControl.Styles>
      <!-- Servers Tab -->
      <TabItem x:Name="ServersTab" Padding="16">
        <TabItem.Header>
          <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Tab_Servers}" FontSize="13" FontWeight="Medium"/>
        </TabItem.Header>
        <DockPanel>
          <!-- Filters & Add Server -->
          <Border DockPanel.Dock="Top" Padding="0,0,0,16">
            <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Text="{Binding ServerLink, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ph_ServerLink}" Width="400" Padding="12,10" BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="10" Background="#FFFFFF" FontSize="13">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding AddLinkCommand}"/>
                  </TextBox.KeyBindings>
                </TextBox>
                <Button Padding="16,10" CornerRadius="10" Background="#0E7C6B" Foreground="White" FontSize="13" FontWeight="SemiBold">
                  <Button.Flyout>
                    <MenuFlyout Placement="Bottom">
                      <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Add_Link}" Command="{Binding AddLinkCommand}"/>
                      <Separator/>
                      <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Add_VMess}" Command="{Binding AddManualServerCommand}" CommandParameter="VMess"/>
                      <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Add_VLESS}" Command="{Binding AddManualServerCommand}" CommandParameter="VLESS"/>
                      <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Add_SS}" Command="{Binding AddManualServerCommand}" CommandParameter="Shadowsocks"/>
                      <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Add_Trojan}" Command="{Binding AddManualServerCommand}" CommandParameter="Trojan"/>
                      <Separator/>
                      <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Add_Clipboard}" Command="{Binding ImportFromClipboardCommand}"/>
                    </MenuFlyout>
                  </Button.Flyout>
                  <TextBlock>
                    <TextBlock.Text>
                      <Binding Path="." Converter="{x:Static loc:TranslateConverter.Instance}" ConverterParameter="Btn_Add"/>
                    </TextBlock.Text>
                  </TextBlock>
                </Button>
              </StackPanel>
              
              <!-- Action Buttons -->
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_Real}" Command="{Binding TestRealDelayAllCommand}" IsVisible="{Binding IsTesting, Converter={StaticResource Not}}" Padding="12,8" CornerRadius="8" Background="#F5F5F5" Foreground="#555555" FontSize="12" BorderThickness="0"/>
                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsTesting}" VerticalAlignment="Center">
                  <Border Width="120" Height="8" Background="#E5E7EB" CornerRadius="4" ClipToBounds="True" VerticalAlignment="Center">
                    <Border Width="120" Background="#7C3AED" Height="8" CornerRadius="4" HorizontalAlignment="Left" RenderTransformOrigin="0,0.5">
                      <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding TestProgressPercent}"/>
                      </Border.RenderTransform>
                    </Border>
                  </Border>
                  <TextBlock Text="{Binding TestProgressText}" FontSize="11" Foreground="#666666" VerticalAlignment="Center" MinWidth="36"/>
                  <Button Content="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_Stop}" Command="{Binding StopTestCommand}" Padding="12,8" CornerRadius="8" Background="#FFF5F5" Foreground="#E53E3E" FontSize="12" BorderThickness="0"/>
                </StackPanel>
                <Button Content="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_SpeedAll}" Command="{Binding TestSpeedCommand}" IsVisible="{Binding IsTesting, Converter={StaticResource Not}}" Padding="12,8" CornerRadius="8" Background="#F5F5F5" Foreground="#555555" FontSize="12" BorderThickness="0"/>
                <Button Content="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_PingAll}" Command="{Binding TestAllCommand}" IsVisible="{Binding IsTesting, Converter={StaticResource Not}}" Padding="12,8" CornerRadius="8" Background="#F5F5F5" Foreground="#555555" FontSize="12" BorderThickness="0"/>
                <Button Command="{Binding RemoveDuplicatesCommand}" IsVisible="{Binding HasDuplicates}" Padding="12,8" CornerRadius="8" Background="#FFF5F5" Foreground="#E53E3E" FontSize="12" BorderThickness="0">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_RemoveDupes}"/>
                    <TextBlock Text="{Binding DuplicateCount}" FontWeight="Bold"/>
                  </StackPanel>
                </Button>
                <!-- نکتهٔ گوشه‌ای به‌جای بجِ شبیه دکمه: بدون پس‌زمینه و بدون حسِ دکمه -->
                <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Hint_BypassTun}"
                           IsVisible="{Binding TestsBypassingTun}" FontSize="11" FontStyle="Italic"
                           Foreground="#6B7280" VerticalAlignment="Center" Margin="6,0,0,0"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Servers List -->
          <ScrollViewer x:Name="GroupsScrollViewer" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}">
              <ItemsControl.Styles>
                <Style Selector="ContentPresenter">
                  <Setter Property="HorizontalAlignment" Value="Stretch"/>
                </Style>
              </ItemsControl.Styles>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ServerGroup">
                  <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                    <Expander.Header>
                      <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <!-- Right side (RTL: Column 0 = right) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding AllServersChecked, Mode=TwoWay}"/>
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CountText}" Opacity="0.5" FontSize="12" VerticalAlignment="Center"/>
                          </StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsSubscription}">
                            <Border Width="72" Height="6" Background="#E0E0E0" CornerRadius="3" ClipToBounds="True" VerticalAlignment="Center"
                                    IsVisible="{Binding Subscription.TrafficDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                              <Border Width="72" Height="6" Background="#2FC1A6" HorizontalAlignment="Left" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                  <ScaleTransform ScaleX="{Binding Subscription.TrafficPercent}"/>
                                </Border.RenderTransform>
                              </Border>
                            </Border>
                            <TextBlock Text="{Binding Subscription.TrafficDisplay}" FontSize="11" Foreground="#666666" VerticalAlignment="Center"
                                       IsVisible="{Binding Subscription.TrafficDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Text="{Binding Subscription.ExpireText}" FontSize="11" Foreground="#666666" VerticalAlignment="Center"
                                       IsVisible="{Binding Subscription.ExpireText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                          </StackPanel>
                          <Button Content="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_UpdateAll}" Padding="8,4" IsVisible="{Binding IsAllGroup}" Command="{Binding Owner.UpdateSubscriptionsCommand}" CornerRadius="6" Background="#FFF3E0" Foreground="#E65100" FontSize="11" BorderThickness="0"/>
                          <Button Content="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_Update}" Padding="8,4" IsVisible="{Binding IsManualGroup}" Command="{Binding Owner.UpdateGroupServersCommand}" CommandParameter="{Binding}" CornerRadius="6" Background="#FFF3E0" Foreground="#E65100" FontSize="11" BorderThickness="0"/>
                          <Button Content="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_RemoveAll}" Padding="8,4" IsVisible="{Binding IsManualGroup}" Command="{Binding Owner.RemoveGroupServersCommand}" CommandParameter="{Binding}" CornerRadius="6" Background="#FFF5F5" Foreground="#E53E3E" FontSize="11" BorderThickness="0"/>
                        </StackPanel>
                        <!-- Hamburger + Sort (RTL: Column 1 = left) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding GroupSortField, Mode=TwoWay}" Width="110" Padding="4,3" FontSize="10" VerticalAlignment="Center"/>
                          <Button Padding="6,4" CornerRadius="6" Background="Transparent" Foreground="#888888" FontSize="16" BorderThickness="0">
                            <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                              <MenuItem IsVisible="{Binding IsSubscription}" Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_CopyUrl}" Command="{Binding Owner.CopySubscriptionUrlCommand}" CommandParameter="{Binding Subscription}"/>
                              <MenuItem IsVisible="{Binding IsNotSubscription}" Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_CopyUrl}" Command="{Binding Owner.CopyGroupLinksCommand}" CommandParameter="{Binding}"/>
                              <MenuItem IsVisible="{Binding IsSubscription}" Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_Update}" Command="{Binding Owner.UpdateSingleSubscriptionCommand}" CommandParameter="{Binding Subscription}"/>
                              <MenuItem IsVisible="{Binding IsManualGroup}" Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_Update}" Command="{Binding Owner.UpdateGroupServersCommand}" CommandParameter="{Binding}"/>
                              <MenuItem IsVisible="{Binding IsAllGroup}" Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_UpdateAll}" Command="{Binding Owner.UpdateSubscriptionsCommand}"/>
                              <MenuItem IsVisible="{Binding IsSubscription}" Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_UpdateNoProxy}" Command="{Binding Owner.UpdateSingleSubscriptionNoProxyCommand}" CommandParameter="{Binding Subscription}"/>
                              <MenuItem IsVisible="{Binding IsAllGroup}" Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_UpdateNoProxy}" Command="{Binding Owner.UpdateSubscriptionsNoProxyCommand}"/>
                              <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_Speed}" Command="{Binding Owner.TestGroupSpeedCommand}" CommandParameter="{Binding}"/>
                              <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_Ping}" Command="{Binding Owner.TestGroupCommand}" CommandParameter="{Binding}"/>
                              <Separator IsVisible="{Binding IsNotAllGroup}"/>
                              <MenuItem IsVisible="{Binding IsSubscription}" Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_RemoveSub}" Command="{Binding Owner.RemoveSubscriptionCommand}" CommandParameter="{Binding Subscription}" Foreground="#E53E3E"/>
                              <MenuItem IsVisible="{Binding IsManualGroup}" Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_RemoveAll}" Command="{Binding Owner.RemoveGroupServersCommand}" CommandParameter="{Binding}" Foreground="#E53E3E"/>
                            </MenuFlyout>
                            </Button.Flyout>
                            <TextBlock Text="☰" FontSize="16"/>
                          </Button>
                        </StackPanel>
                      </Grid>
                    </Expander.Header>
                    <!-- Excel-like sortable server table -->
                    <dg:DataGrid ItemsSource="{Binding Servers}"
                                 AutoGenerateColumns="False"
                                 CanUserSortColumns="True"
                                 CanUserResizeColumns="True"
                                 CanUserReorderColumns="True"
                                 GridLinesVisibility="Horizontal"
                                 HeadersVisibility="Column"
                                 SelectionMode="Extended"
                                 SelectedItem="{Binding Owner.SelectedServer, Mode=OneWay}"
                                 SelectionChanged="ServerGrid_SelectionChanged"
                                 IsReadOnly="False"
                                 ContextRequested="ServerGrid_ContextRequested"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 RowBackground="Transparent"
                                 FontSize="12"
                                 RowHeight="34"
                                 ColumnHeaderHeight="36"
                                 Margin="0,4,0,0">
                      <dg:DataGrid.Styles>
                        <Style Selector="DataGridColumnHeader">
                          <Setter Property="Background" Value="#F3F4F6"/>
                          <Setter Property="Foreground" Value="#374151"/>
                          <Setter Property="FontWeight" Value="SemiBold"/>
                          <Setter Property="FontSize" Value="11"/>
                          <Setter Property="BorderBrush" Value="#E5E7EB"/>
                          <Setter Property="BorderThickness" Value="0,0,1,1"/>
                          <Setter Property="Padding" Value="6,0"/>
                        </Style>
                        <Style Selector="DataGridRow">
                          <Setter Property="BorderBrush" Value="#F0F0F0"/>
                          <Setter Property="BorderThickness" Value="0,0,0,1"/>
                          <Setter Property="Background">
                            <Setter.Value>
                              <MultiBinding Converter="{x:Static converters:ServerBgConverter.Instance}">
                                <Binding Path="IsActiveConnection" x:DataType="models:ServerInfo"/>
                                <Binding Path="IsHighlighted" x:DataType="models:ServerInfo"/>
                                <Binding Path="IsSelected" x:DataType="models:ServerInfo"/>
                              </MultiBinding>
                            </Setter.Value>
                          </Setter>
                        </Style>
                        <Style Selector="DataGridRow /template/ ContentPresenter">
                          <Setter Property="Background">
                            <Setter.Value>
                              <MultiBinding Converter="{x:Static converters:ServerBgConverter.Instance}">
                                <Binding Path="IsActiveConnection" x:DataType="models:ServerInfo"/>
                                <Binding Path="IsHighlighted" x:DataType="models:ServerInfo"/>
                                <Binding Path="IsSelected" x:DataType="models:ServerInfo"/>
                              </MultiBinding>
                            </Setter.Value>
                          </Setter>
                        </Style>
                        <Style Selector="DataGridRow:pointerover /template/ ContentPresenter">
                          <Setter Property="Background" Value="#F0FDFA"/>
                        </Style>
                        <Style Selector="DataGridCell">
                          <Style.Resources>
                            <SolidColorBrush x:Key="DataGridCellFocusVisualPrimaryBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="DataGridCellFocusVisualSecondaryBrush" Color="Transparent"/>
                          </Style.Resources>
                          <Setter Property="BorderThickness" Value="0"/>
                          <Setter Property="Padding" Value="4,0"/>
                          <Setter Property="VerticalContentAlignment" Value="Center"/>
                          <Setter Property="Background" Value="Transparent"/>
                        </Style>
                        <Style Selector="DataGridCell /template/ ContentPresenter">
                          <Setter Property="Background" Value="Transparent"/>
                        </Style>
                        <Style Selector="DataGridCell:selected /template/ ContentPresenter">
                          <Setter Property="Background" Value="Transparent"/>
                        </Style>
                        <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
                          <Setter Property="IsVisible" Value="False"/>
                        </Style>
                      </dg:DataGrid.Styles>
                      <dg:DataGrid.Columns>
                        <!-- Select -->
                        <dg:DataGridTemplateColumn Width="40" IsReadOnly="False" SortMemberPath="IsChecked">
                          <dg:DataGridTemplateColumn.Header>
                            <TextBlock Text="✓" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#0E7C6B"/>
                          </dg:DataGridTemplateColumn.Header>
                          <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:ServerInfo">
                              <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        MinWidth="0" Padding="0" Margin="0"/>
                            </DataTemplate>
                          </dg:DataGridTemplateColumn.CellTemplate>
                        </dg:DataGridTemplateColumn>

                        <!-- Name + flag -->
                        <dg:DataGridTemplateColumn Width="*" SortMemberPath="Name" MinWidth="120">
                          <dg:DataGridTemplateColumn.Header>
                            <TextBlock Text="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=[Header_Name]}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip.Tip="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=[Header_Name]}"/>
                          </dg:DataGridTemplateColumn.Header>
                          <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:ServerInfo">
                              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" VerticalAlignment="Center"/>
                                <Image Width="18" Height="13" VerticalAlignment="Center"
                                       Source="{Binding CountryCode, Converter={x:Static converters:FlagToImageConverter.Instance}}"/>
                                <TextBlock Text="{Binding ShortName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           FontWeight="SemiBold" Foreground="#1A1A1A" ToolTip.Tip="{Binding ToolTipText}"/>
                              </StackPanel>
                            </DataTemplate>
                          </dg:DataGridTemplateColumn.CellTemplate>
                        </dg:DataGridTemplateColumn>

                        <!-- Ping -->
                        <dg:DataGridTemplateColumn Width="90" MinWidth="90" SortMemberPath="PingSortKey" IsReadOnly="True">
                          <dg:DataGridTemplateColumn.Header>
                            <TextBlock Text="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=[Header_Ping]}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip.Tip="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=[Header_Ping]}"/>
                          </dg:DataGridTemplateColumn.Header>
                          <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <Border Background="{Binding PingBgColor}" CornerRadius="4" Padding="6,2" Margin="4,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PingDisplay}" Foreground="{Binding PingTextColor}" FontWeight="SemiBold" FontSize="11"/>
                              </Border>
                            </DataTemplate>
                          </dg:DataGridTemplateColumn.CellTemplate>
                        </dg:DataGridTemplateColumn>

                        <!-- Real delay -->
                        <dg:DataGridTemplateColumn Width="125" MinWidth="125" SortMemberPath="RealDelaySortKey" IsReadOnly="True">
                          <dg:DataGridTemplateColumn.Header>
                            <TextBlock Text="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=[Header_RealDelay]}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip.Tip="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=[Header_RealDelay]}"/>
                          </dg:DataGridTemplateColumn.Header>
                          <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <Border Background="{Binding RealDelayBgColor}" CornerRadius="4" Padding="6,2" Margin="4,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RealDelayDisplay}" Foreground="{Binding RealDelayTextColor}" FontWeight="SemiBold" FontSize="11"/>
                              </Border>
                            </DataTemplate>
                          </dg:DataGridTemplateColumn.CellTemplate>
                        </dg:DataGridTemplateColumn>

                        <!-- Speed -->
                        <dg:DataGridTemplateColumn SortMemberPath="DownloadMbps" Width="110" MinWidth="110" IsReadOnly="True">
                          <dg:DataGridTemplateColumn.Header>
                            <TextBlock Text="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=[Header_Speed]}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip.Tip="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=[Header_Speed]}"/>
                          </dg:DataGridTemplateColumn.Header>
                          <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding SpeedDisplay, Mode=OneWay}" VerticalAlignment="Center"/>
                            </DataTemplate>
                          </dg:DataGridTemplateColumn.CellTemplate>
                        </dg:DataGridTemplateColumn>

                        <!-- Protocol -->
                        <dg:DataGridTextColumn Binding="{Binding ProtocolDisplay}" SortMemberPath="Protocol" Width="110" MinWidth="110" IsReadOnly="True">
                          <dg:DataGridTextColumn.Header>
                            <TextBlock Text="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=[Header_Protocol]}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip.Tip="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=[Header_Protocol]}"/>
                          </dg:DataGridTextColumn.Header>
                        </dg:DataGridTextColumn>

                        <!-- Actions -->
                        <dg:DataGridTemplateColumn Width="140" MinWidth="140" IsReadOnly="True">
                          <dg:DataGridTemplateColumn.Header>
                            <TextBlock Text="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=[Header_Status]}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip.Tip="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=[Header_Status]}"/>
                          </dg:DataGridTemplateColumn.Header>
                          <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <!-- Connect -->
                                <Button ToolTip.Tip="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Card_Connect}" Height="26" Padding="8,0" Command="{Binding Owner.ConnectServerCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsActiveConnection, Converter={StaticResource Not}}" Background="#FFFFFF" Foreground="#0E7C6B" CornerRadius="6" BorderThickness="0">
                                  <TextBlock FontSize="11" FontWeight="SemiBold">
                                    <TextBlock.Text>
                                      <Binding Path="." Converter="{x:Static loc:TranslateConverter.Instance}" ConverterParameter="Card_Connect" StringFormat="▶  {0}"/>
                                    </TextBlock.Text>
                                  </TextBlock>
                                </Button>
                                <!-- Disconnect -->
                                <Button ToolTip.Tip="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Card_Disconnect}" Height="30" Padding="12,0" Command="{Binding Owner.DisconnectCommand}" IsVisible="{Binding IsActiveConnection}" Background="#E53E3E" Foreground="#FFFFFF" CornerRadius="8" BorderThickness="0">
                                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Viewbox Width="13" Height="13" VerticalAlignment="Center">
                                      <Path Data="M18.36 6.64a9 9 0 1 1-12.73 0M12 2v10" Stroke="White" StrokeThickness="2.2" StrokeLineCap="Round"/>
                                    </Viewbox>
                                    <TextBlock FontSize="12" FontWeight="SemiBold">
                                      <TextBlock.Text>
                                        <Binding Path="." Converter="{x:Static loc:TranslateConverter.Instance}" ConverterParameter="Card_Disconnect"/>
                                      </TextBlock.Text>
                                    </TextBlock>
                                  </StackPanel>
                                </Button>
                                <!-- More menu -->
                                <Button Padding="6,4" CornerRadius="6" Background="Transparent" Foreground="#6B7280" FontSize="14" BorderThickness="0" ToolTip.Tip="...">
                                  <Button.Flyout>
                                    <MenuFlyout Placement="Bottom">
                                      <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ctx_Edit}" Command="{Binding Owner.EditServerCommand}" CommandParameter="{Binding}"/>
                                      <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ctx_Clone}" Command="{Binding Owner.CloneServerCommand}" CommandParameter="{Binding}"/>
                                      <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ctx_Share}" Command="{Binding Owner.ShareServerCommand}" CommandParameter="{Binding}"/>
                                      <Separator/>
                                      <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ctx_TestPing}" Command="{Binding Owner.TestOneServerCommand}" CommandParameter="{Binding}"/>
                                      <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ctx_TestReal}" Command="{Binding Owner.TestOneRealDelayCommand}" CommandParameter="{Binding}"/>
                                      <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ctx_TestSpeed}" Command="{Binding Owner.TestOneSpeedCommand}" CommandParameter="{Binding}"/>
                                      <Separator/>
                                      <MenuItem Header="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ctx_Delete}" Command="{Binding Owner.RemoveServerCommand}" CommandParameter="{Binding}" Foreground="#E53E3E"/>
                                    </MenuFlyout>
                                  </Button.Flyout>
                                  <TextBlock Text="⋯" FontSize="16"/>
                                </Button>
                              </StackPanel>
                            </DataTemplate>
                          </dg:DataGridTemplateColumn.CellTemplate>
                        </dg:DataGridTemplateColumn>
                      </dg:DataGrid.Columns>
                    </dg:DataGrid>
                  </Expander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <!-- Subscriptions Tab -->
      <TabItem Padding="16">
        <TabItem.Header>
          <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Tab_Subscription}" FontSize="13" FontWeight="Medium"/>
        </TabItem.Header>
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Text="{Binding SubName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ph_SubName}" Width="150" Padding="10,8" CornerRadius="6"/>
              <TextBox Text="{Binding SubUrl, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Ph_SubUrl}" Width="400" Padding="10,8" CornerRadius="6"/>
              <Button Command="{Binding AddSubscriptionCommand}" Padding="16,8" CornerRadius="6" Background="{StaticResource PrimaryBrush}" Foreground="White">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Viewbox Width="13" Height="13">
                    <Path Data="M12 5v14M5 12h14" Stroke="White" StrokeThickness="2.4" StrokeLineCap="Round"/>
                  </Viewbox>
                  <TextBlock FontSize="13">
                    <TextBlock.Text>
                      <Binding Path="." Converter="{x:Static loc:TranslateConverter.Instance}" ConverterParameter="Btn_Add"/>
                    </TextBlock.Text>
                  </TextBlock>
                </StackPanel>
              </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Content="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_UpdateAll}" Command="{Binding UpdateSubscriptionsCommand}" Padding="12,8" CornerRadius="6"/>
              <Button Content="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_Diagnose}" Command="{Binding DiagnoseSubscriptionsCommand}" Padding="12,8" CornerRadius="6"/>
              <CheckBox Content="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Sub_UseProxy}" IsChecked="{Binding UseProxyForSubscriptions}" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
          </StackPanel>
          
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Subscriptions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="6" Padding="16" Margin="0,8,0,0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Cursor="Hand" Tag="{Binding Name}" PointerPressed="SubscriptionCard_PointerPressed">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text="{Binding ServerCountText}" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding TrafficDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                          <TextBlock Text="{Binding TrafficDisplay}" FontSize="11" Foreground="#666666"/>
                          <TextBlock Text="{Binding ExpireText}" FontSize="11" Foreground="#666666"/>
                        </StackPanel>
                        <Border CornerRadius="2" Height="4" Background="#E0E0E0" ClipToBounds="True" IsVisible="{Binding TrafficDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Margin="0,2,0,0">
                          <Border CornerRadius="2" Height="4" Background="#2FC1A6" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                              <ScaleTransform ScaleX="{Binding TrafficPercent}"/>
                            </Border.RenderTransform>
                          </Border>
                        </Border>
                      </StackPanel>
                      <Button Grid.Column="1" Padding="0" Width="32" Height="32" Margin="12,0,0,0" CornerRadius="8" Background="#EEF2FF" BorderThickness="0" Command="{Binding #RootWindow.DataContext.CopySubscriptionUrlCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_CopyUrl}">
                        <Viewbox Width="15" Height="15">
                          <Path Data="M8 8h11a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V10a2 2 0 0 1 2-2zM5 16H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v1"
                                Fill="Transparent" Stroke="#4F46E5" StrokeThickness="2"/>
                        </Viewbox>
                      </Button>
                      <Button Grid.Column="2" Padding="0" Width="32" Height="32" Margin="4,0,0,0" CornerRadius="8" Background="#FFF7ED" BorderThickness="0" Command="{Binding #RootWindow.DataContext.UpdateSingleSubscriptionCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_Update}">
                        <Viewbox Width="15" Height="15">
                          <Path Data="M21 4v6h-6M3 20v-6h6M4.5 9a9 9 0 0 1 15-3.4L21 9M3 15l1.5 3.4A9 9 0 0 0 19.5 15"
                                Fill="Transparent" Stroke="#EA580C" StrokeThickness="2" StrokeLineCap="Round"/>
                        </Viewbox>
                      </Button>
                      <Button Grid.Column="3" Padding="0" Width="32" Height="32" Margin="4,0,8,0" CornerRadius="8" Background="#FEF2F2" BorderThickness="0" Command="{Binding #RootWindow.DataContext.RemoveSubscriptionCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Btn_RemoveSub}">
                        <Viewbox Width="15" Height="15">
                          <Path Data="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6h14zM10 11v6M14 11v6"
                                Fill="Transparent" Stroke="#DC2626" StrokeThickness="2" StrokeLineCap="Round"/>
                        </Viewbox>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <!-- Log Tab -->
      <TabItem Padding="16">
        <TabItem.Header>
          <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Tab_Log}" FontSize="13" FontWeight="Medium"/>
        </TabItem.Header>
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Filter_Label}" VerticalAlignment="Center" FontSize="12" Foreground="#888"/>
            <ComboBox ItemsSource="{Binding LogFilters}" SelectedItem="{Binding LogFilter}" Width="130" Padding="4,3" FontSize="12"/>
          </StackPanel>
          <TextBox Text="{Binding FilteredLogText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Background="#F5F5F5" BorderThickness="0"/>
        </DockPanel>
      </TabItem>

      <!-- Settings Tab -->
      <TabItem Padding="16">
        <TabItem.Header>
          <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Tab_Settings}" FontSize="13" FontWeight="Medium"/>
        </TabItem.Header>
        <ScrollViewer>
          <StackPanel Spacing="16">
            <Border CornerRadius="6" Padding="16" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_Connection}" FontWeight="Bold" FontSize="13"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <RadioButton GroupName="ProxyMode" IsChecked="{Binding SetSystemProxy}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_Proxy}" VerticalAlignment="Center" Opacity="{Binding LeaveSystemProxyAsIs, Converter={StaticResource BoolToOpacity}}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <RadioButton GroupName="ProxyMode" IsChecked="{Binding LeaveSystemProxyAsIs}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_LeaveProxy}" VerticalAlignment="Center" Opacity="{Binding SetSystemProxy, Converter={StaticResource BoolToOpacity}}"/>
                </StackPanel>
                <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_LeaveProxy_Desc}" FontSize="11" Foreground="#888888" Margin="24,0,0,0"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox IsChecked="{Binding ClearProxyOnDisconnect}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_ClearProxy}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_ClearProxy_Desc}" FontSize="11" Foreground="#888888" Margin="24,0,0,0"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox IsChecked="{Binding AutoConnect}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_AutoConnect}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_AutoConnect_Desc}" FontSize="11" Foreground="#888888" Margin="24,0,0,0"/>
              </StackPanel>
            </Border>

            <Border CornerRadius="6" Padding="16" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <ToggleSwitch IsChecked="{Binding UseTunMode}"/>
                  <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_TUN}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_TUN_Desc}" FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox IsChecked="{Binding TestsViaTun}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_TestsViaTun}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_TestsViaTun_Desc}" FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <Border CornerRadius="6" Padding="16" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ToggleSwitch IsChecked="{Binding KillSwitchEnabled}"/>
                  <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_KillSwitch}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_KillSwitch_Desc}" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding KillSwitchStatus}" FontSize="11" Foreground="#F59E0B" TextWrapping="Wrap" IsVisible="{Binding KillSwitchEngaged}"/>
                <Button Content="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_KillSwitch_Emergency}" Command="{Binding EmergencyReleaseCommand}" IsVisible="{Binding KillSwitchEngaged}" Padding="12,6" CornerRadius="6" Background="#B91C1C" Foreground="White" FontSize="11" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_KillSwitch_Hint}" FontSize="11" Foreground="#888888" TextWrapping="Wrap" IsVisible="{Binding KillSwitchEngaged}"/>
              </StackPanel>
            </Border>

            <Border CornerRadius="6" Padding="16" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_TunExclude}" FontWeight="Bold" FontSize="13"/>
                <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_TunExclude_Desc}" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox IsChecked="{Binding BypassVpnWithoutTun}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_Bypass}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_Bypass_Desc}" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>
                <Border CornerRadius="6" Padding="10,8" Background="#0E7C6B14" BorderBrush="#0E7C6B40" BorderThickness="1">
                  <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_TunExclude_Note}" FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                </Border>
                <Button Content="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_TunExclude_Add}" Padding="14,8" CornerRadius="8" Background="#0E7C6B" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Command="{Binding AddTunExcludedAppCommand}"/>
                <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_TunExclude_Empty}" FontSize="11" Foreground="#AAAAAA" IsVisible="{Binding TunExcludedEmpty}"/>
                <ListBox ItemsSource="{Binding TunExcludedApps}" MaxHeight="150" Background="Transparent" BorderThickness="0" Padding="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <ToggleSwitch Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"
                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                      Command="{Binding #RootWindow.DataContext.ToggleTunExcludedAppCommand}"
                                      CommandParameter="{Binding}"
                                      AutomationProperties.Name="{Binding Name}"
                                      ToolTip.Tip="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_TunExclude_Toggle}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip.Tip="{Binding Path}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center" IsEnabled="{Binding IsEnabled}"/>
                        <Button Grid.Column="2" Content="✕" FontSize="12" Padding="8,2" Margin="8,0,0,0" Background="Transparent" BorderThickness="0" Foreground="#DC2626" Command="{Binding #RootWindow.DataContext.RemoveTunExcludedAppCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_TunExclude_Remove}"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Border>

            <Border CornerRadius="6" Padding="16" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_DNS}" FontWeight="Bold" FontSize="13"/>
                <Button Content="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_DNSBtn}" Padding="16,10" CornerRadius="8" Background="#0E7C6B" Foreground="White" FontSize="13" FontWeight="SemiBold" Command="{Binding OpenDnsSettingsCommand}"/>
              </StackPanel>
            </Border>

            <Border CornerRadius="6" Padding="16" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_SubscriptionUpdate}" FontWeight="Bold" FontSize="13"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox IsChecked="{Binding AutoUpdateSubs}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_AutoUpdate}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding AutoUpdateSubs}">
                  <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_Every}" VerticalAlignment="Center"/>
                  <TextBox Text="{Binding AutoUpdateIntervalHours}" Width="60" Padding="6,4" HorizontalContentAlignment="Center"/>
                  <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_Hours}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding LastUpdateDisplay}" FontSize="11" Foreground="{StaticResource TextSecondary}" IsVisible="{Binding AutoUpdateSubs}"/>
              </StackPanel>
            </Border>

            <Border CornerRadius="6" Padding="16" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_AppUpdate}" FontWeight="Bold" FontSize="13"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox IsChecked="{Binding AutoUpdate}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_AutoUpdateApp}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_AutoUpdateApp_Desc}" FontSize="11" Foreground="#888888" Margin="24,0,0,0"/>
              </StackPanel>
            </Border>

            <Border CornerRadius="6" Padding="16" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_Advanced}" FontWeight="Bold" FontSize="13"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_PingType}" VerticalAlignment="Center"/>
                  <ComboBox ItemsSource="{Binding PingTypeOptions}" SelectedItem="{Binding SelectedPingType}" Width="160"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox IsChecked="{Binding GlobalSort}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_GlobalSort}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border CornerRadius="6" Padding="16" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="{Binding Converter={x:Static loc:TranslateConverter.Instance}, ConverterParameter=Set_Language}" FontWeight="Bold" FontSize="13"/>
                <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}" Width="160" Padding="4,4" FontSize="13"/>
              </StackPanel>
            </Border>

            <TextBlock Text="Roxa 3.0 • Avalonia" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,16,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <!-- Toast Notification -->
    <Border x:Name="ToastBorder" IsVisible="False" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,80,0,0" ZIndex="100"
            Background="#122A25" CornerRadius="10" Padding="20,12" MaxWidth="400">
      <TextBlock x:Name="ToastText" Text="" FontSize="13" Foreground="White" TextWrapping="Wrap" TextAlignment="Center"/>
    </Border>
  </Grid>
</Window>
