<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XrayClient.ViewModels"
        xmlns:models="using:XrayClient.Models"
        xmlns:converters="using:XrayClient.Converters"
        xmlns:dg="using:Avalonia.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="XrayClient.Views.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainViewModel"
        Title="Roxa" Width="900" Height="700" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource Vazirmatn}"
        Background="#F8F9FA">

  <Window.Styles>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType=Button}}"/>
    </Style>
  </Window.Styles>

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <Window.Resources>
    <converters:BoolNegateConverter x:Key="Not"/>
    <converters:BoolToBrushConverter x:Key="ActiveBrush"/>
    
    <!-- رنگ‌های تیل -->
    <SolidColorBrush x:Key="PrimaryBrush">#0E7C6B</SolidColorBrush>
    <SolidColorBrush x:Key="SuccessBrush">#0E7C6B</SolidColorBrush>
    <SolidColorBrush x:Key="WarningBrush">#C97A2B</SolidColorBrush>
    <SolidColorBrush x:Key="ErrorBrush">#C4463A</SolidColorBrush>
    <SolidColorBrush x:Key="CardBackground">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="BorderLight">#E1E8E6</SolidColorBrush>
    <SolidColorBrush x:Key="TextPrimary">#122A25</SolidColorBrush>
    <SolidColorBrush x:Key="TextSecondary">#5C6E6A</SolidColorBrush>

    <DataTemplate x:Key="ServerRowTemplate" DataType="models:ServerInfo">
      <Border CornerRadius="12" 
              Padding="16,14" 
              Margin="0,6,0,0"
              HorizontalAlignment="Stretch"
              Background="{Binding IsActiveConnection, Converter={x:Static converters:ActiveToBrushConverter.Instance}}"
              BorderBrush="{Binding IsActiveConnection, Converter={x:Static converters:ActiveToBorderConverter.Instance}}"
              BorderThickness="1">
        
        <Border.ContextMenu>
          <ContextMenu Padding="4">
            <MenuItem Header="اتصال" Command="{Binding Owner.ConnectServerCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsActiveConnection, Converter={StaticResource Not}}"/>
            <MenuItem Header="قطع اتصال" Command="{Binding Owner.DisconnectCommand}" IsVisible="{Binding IsActiveConnection}"/>
            <Separator/>
            <MenuItem Header="ویرایش سرور" Command="{Binding Owner.EditServerCommand}" CommandParameter="{Binding}"/>
            <MenuItem Header="کپی سرور" Command="{Binding Owner.CloneServerCommand}" CommandParameter="{Binding}"/>
            <MenuItem Header="اشتراک‌گذاری" Command="{Binding Owner.ShareServerCommand}" CommandParameter="{Binding}"/>
            <Separator/>
            <MenuItem Header="تست Ping" Command="{Binding Owner.TestOneServerCommand}" CommandParameter="{Binding}"/>
            <MenuItem Header="تست پینگ واقعی" Command="{Binding Owner.TestOneRealDelayCommand}" CommandParameter="{Binding}"/>
            <MenuItem Header="تست سرعت" Command="{Binding Owner.TestOneSpeedCommand}" CommandParameter="{Binding}"/>
            <Separator/>
            <MenuItem Header="حذف سرور" Command="{Binding Owner.RemoveServerCommand}" CommandParameter="{Binding}" Foreground="{StaticResource ErrorBrush}"/>
          </ContextMenu>
        </Border.ContextMenu>

        <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto" Margin="0">
          <!-- Status Dot -->
          <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,12,0" Fill="{Binding StatusColor}"/>

          <!-- Server Name & Details -->
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#1A1A1A" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
              <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock FontSize="12" Foreground="#888888">
                <Run Text="پینگ: "/>
                <Run Text="{Binding LatencyDisplay, Mode=OneWay}"/>
              </TextBlock>
              <TextBlock Text="·" FontSize="12" Foreground="#CCCCCC"/>
              <TextBlock FontSize="12" Foreground="#888888">
                <Run Text="سرعت: "/>
                <Run Text="{Binding SpeedDisplay, Mode=OneWay}"/>
              </TextBlock>
            </StackPanel>
          </StackPanel>

          <!-- Metrics (hidden, data shown in details above) -->
          
          <!-- Action Buttons - Outline Style -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="12,0,0,0">
            <Button ToolTip.Tip="اتصال" Padding="8,6" Command="{Binding Owner.ConnectServerCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsActiveConnection, Converter={StaticResource Not}}" Background="Transparent" Foreground="#0E7C6B" CornerRadius="8" BorderThickness="1" BorderBrush="#D0D0D0">
              <TextBlock Text="▶" FontSize="12"/>
            </Button>
            <Button ToolTip.Tip="قطع" Padding="8,6" Command="{Binding Owner.DisconnectCommand}" IsVisible="{Binding IsActiveConnection}" Background="Transparent" Foreground="#E53E3E" CornerRadius="8" BorderThickness="1" BorderBrush="#D0D0D0">
              <TextBlock Text="✕" FontSize="12"/>
            </Button>
            <Button ToolTip.Tip="ویرایش" Padding="8,6" Command="{Binding Owner.EditServerCommand}" CommandParameter="{Binding}" Background="Transparent" Foreground="#0E7C6B" CornerRadius="8" BorderThickness="1" BorderBrush="#D0D0D0">
              <TextBlock Text="✎" FontSize="12"/>
            </Button>
            <Button ToolTip.Tip="اشتراک" Padding="8,6" Command="{Binding Owner.ShareServerCommand}" CommandParameter="{Binding}" Background="Transparent" Foreground="#D97706" CornerRadius="8" BorderThickness="1" BorderBrush="#D0D0D0">
              <TextBlock Text="📋" FontSize="11"/>
            </Button>
            <Button ToolTip.Tip="حذف" Padding="8,6" Command="{Binding Owner.RemoveServerCommand}" CommandParameter="{Binding}" Background="Transparent" Foreground="#E53E3E" CornerRadius="8" BorderThickness="1" BorderBrush="#D0D0D0">
              <TextBlock Text="🗑" FontSize="11"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid RowDefinitions="Auto,*" Background="#F7F8FA">
    <!-- Top Bar -->
    <Border Grid.Row="0" Padding="0" Background="#FFFFFF" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="24,14,24,14">
        <!-- Logo -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Image Source="avares://XrayClient/Assets/roxa-icon.png" Width="30" Height="30"/>
          <TextBlock Text="Roxa" FontSize="18" FontWeight="Bold" Foreground="#0B2420" VerticalAlignment="Center" Margin="0,0,4,0"/>
        </StackPanel>

        <!-- Server Status (center) -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock Text="{Binding HomeServerName}" FontSize="14" FontWeight="Medium" Foreground="#333333" MaxWidth="300" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          <Ellipse Width="8" Height="8" Fill="#22C55E" IsVisible="{Binding IsConnected}" VerticalAlignment="Center"/>
          <Ellipse Width="8" Height="8" Fill="#CCCCCC" IsVisible="{Binding IsConnected, Converter={StaticResource Not}}" VerticalAlignment="Center"/>
          <TextBlock FontSize="12" Foreground="#888888" VerticalAlignment="Center" IsVisible="{Binding IsConnected}">
            <Run Text="متصل"/>
            <Run Text=" · "/>
            <Run Text="{Binding HomeLatency, Mode=OneWay}"/>
          </TextBlock>
        </StackPanel>

        <!-- Connect Button (when not connected) -->
        <Button Grid.Column="2" Command="{Binding ConnectCommand}" Padding="14,8" IsVisible="{Binding IsConnected, Converter={StaticResource Not}}" Background="#0E7C6B" Foreground="White" CornerRadius="8" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold">
          ▶ اتصال
        </Button>
        <!-- Disconnect Button (when connected) -->
        <Button Grid.Column="2" Command="{Binding DisconnectCommand}" Padding="14,8" IsVisible="{Binding IsConnected}" Background="#E53E3E" Foreground="White" CornerRadius="8" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold">
          قطع اتصال
        </Button>
      </Grid>
    </Border>

    <!-- Tabs -->
    <TabControl Grid.Row="1" Margin="24,0,24,0" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <TabControl.Styles>
        <Style Selector="TabControl">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TabItem">
          <Setter Property="FontSize" Value="13"/>
          <Setter Property="FontWeight" Value="Medium"/>
          <Setter Property="Padding" Value="16,10"/>
          <Setter Property="Margin" Value="0"/>
          <Setter Property="Foreground" Value="#999999"/>
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="CornerRadius" Value="0"/>
          <Setter Property="BorderThickness" Value="0,0,0,2"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TabItem:pointerover">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="Foreground" Value="#555555"/>
        </Style>
        <Style Selector="TabItem:selected">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="Foreground" Value="#0E7C6B"/>
          <Setter Property="BorderBrush" Value="#0E7C6B"/>
        </Style>
      </TabControl.Styles>
      <!-- Servers Tab -->
      <TabItem Header="سرورها" Padding="16">
        <DockPanel>
          <!-- Filters & Add Server -->
          <Border DockPanel.Dock="Top" Padding="0,0,0,16">
            <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Text="{Binding ServerLink}" PlaceholderText="لینک سرور (vmess://, vless://, ...)" Width="400" Padding="12,10" BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="10" Background="#FFFFFF" FontSize="13"/>
                <Button Padding="16,10" CornerRadius="10" Background="#0E7C6B" Foreground="White" FontSize="16" FontWeight="Bold">
                  <Button.Flyout>
                    <MenuFlyout Placement="Bottom">
                      <MenuItem Header="🔗  افزودن با لینک" Command="{Binding AddLinkCommand}"/>
                      <Separator/>
                      <MenuItem Header="🟢  افزودن VMess" Command="{Binding AddManualServerCommand}" CommandParameter="VMess"/>
                      <MenuItem Header="🔵  افزودن VLESS" Command="{Binding AddManualServerCommand}" CommandParameter="VLESS"/>
                      <MenuItem Header="🟠  افزودن Shadowsocks" Command="{Binding AddManualServerCommand}" CommandParameter="Shadowsocks"/>
                      <MenuItem Header="🔴  افزودن Trojan" Command="{Binding AddManualServerCommand}" CommandParameter="Trojan"/>
                      <Separator/>
                      <MenuItem Header="📋  وارد کردن از کلیپبورد" Command="{Binding ImportFromClipboardCommand}"/>
                    </MenuFlyout>
                  </Button.Flyout>
                  +
                </Button>
                <Button Command="{Binding SmartConnectCommand}" IsVisible="{Binding ShowSmartConnectButton}" Padding="14,10" CornerRadius="10" Background="#7C3AED" Foreground="White" FontSize="13" FontWeight="SemiBold">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="⚡" VerticalAlignment="Center"/>
                    <TextBlock Text="اتصال هوشمند" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button IsVisible="{Binding IsSmartConnecting}" IsEnabled="False" Padding="14,10" CornerRadius="10" Background="#5B21B6" Foreground="White" FontSize="13" FontWeight="SemiBold">
                  <Grid>
                    <Border Background="#7C3AED" CornerRadius="10" HorizontalAlignment="Left" RenderTransformOrigin="0,0.5">
                      <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding SearchProgressPercent}"/>
                      </Border.RenderTransform>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center" ZIndex="10">
                      <TextBlock Text="◉" VerticalAlignment="Center" FontSize="16" Foreground="White"/>
                      <TextBlock Text="{Binding SearchProgressText}" VerticalAlignment="Center" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                  </Grid>
                </Button>
                <Button Command="{Binding FindBetterServerCommand}" IsVisible="{Binding IsConnected}" IsEnabled="{Binding IsFindingBetter, Converter={StaticResource Not}}" Padding="14,10" CornerRadius="10" Background="#065F46" Foreground="White" FontSize="13" FontWeight="SemiBold" BorderThickness="0">
                  <Grid>
                    <Border Background="#0E7C6B" CornerRadius="10" HorizontalAlignment="Left" RenderTransformOrigin="0,0.5">
                      <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding SearchProgressPercent}"/>
                      </Border.RenderTransform>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center" ZIndex="10">
                      <TextBlock Text="🔍" VerticalAlignment="Center" IsVisible="{Binding IsFindingBetter, Converter={StaticResource Not}}"/>
                      <TextBlock Text="◉" VerticalAlignment="Center" FontSize="16" IsVisible="{Binding IsFindingBetter}" Foreground="White"/>
                      <TextBlock Text="یافتن سرور بهتر" VerticalAlignment="Center" IsVisible="{Binding IsFindingBetter, Converter={StaticResource Not}}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding SearchProgressText}" VerticalAlignment="Center" IsVisible="{Binding IsFindingBetter}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                  </Grid>
                </Button>
              </StackPanel>
              
              <!-- Action Buttons -->
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="🔄 پینگ همه" Command="{Binding TestAllCommand}" IsVisible="{Binding IsTesting, Converter={StaticResource Not}}" Padding="12,8" CornerRadius="8" Background="#F5F5F5" Foreground="#555555" FontSize="12" BorderThickness="0"/>
                <Button Content="توقف" Command="{Binding StopTestCommand}" IsVisible="{Binding IsTesting}" Padding="12,8" CornerRadius="8" Background="#FFF5F5" Foreground="#E53E3E" FontSize="12" BorderThickness="0"/>
                <Button Content="⚡ پینگ واقعی" Command="{Binding TestRealDelayAllCommand}" IsVisible="{Binding IsTesting, Converter={StaticResource Not}}" Padding="12,8" CornerRadius="8" Background="#F5F5F5" Foreground="#555555" FontSize="12" BorderThickness="0"/>
                <Button Content="🚀 سرعت" Command="{Binding TestSpeedCommand}" IsVisible="{Binding IsTesting, Converter={StaticResource Not}}" Padding="12,8" CornerRadius="8" Background="#F5F5F5" Foreground="#555555" FontSize="12" BorderThickness="0"/>
                <Button Content="🗑️ حذف تکراری" Command="{Binding RemoveDuplicatesCommand}" Padding="12,8" CornerRadius="8" Background="#FFF5F5" Foreground="#E53E3E" FontSize="12" BorderThickness="0"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Servers List -->
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}">
              <ItemsControl.Styles>
                <Style Selector="ContentPresenter">
                  <Setter Property="HorizontalAlignment" Value="Stretch"/>
                </Style>
              </ItemsControl.Styles>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ServerGroup">
                  <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                    <Expander.Header>
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,4">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <CheckBox IsChecked="{Binding AllServersChecked, Mode=TwoWay}"/>
                          <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding CountText}" Opacity="0.5" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <Button Content="پینگ" Padding="8,4" Command="{Binding Owner.TestGroupCommand}" CommandParameter="{Binding}" CornerRadius="6" Background="#F5F5F5" Foreground="#555555" FontSize="11" BorderThickness="0"/>
                          <Button Content="واقعی" Padding="8,4" Command="{Binding Owner.TestGroupRealDelayCommand}" CommandParameter="{Binding}" CornerRadius="6" Background="#F5F5F5" Foreground="#555555" FontSize="11" BorderThickness="0"/>
                          <Button Content="سرعت" Padding="8,4" Command="{Binding Owner.TestGroupSpeedCommand}" CommandParameter="{Binding}" CornerRadius="6" Background="#F5F5F5" Foreground="#555555" FontSize="11" BorderThickness="0"/>
                          <Button Content="بروزرسانی" Padding="8,4" IsVisible="{Binding IsSubscription}" Command="{Binding Owner.UpdateSingleSubscriptionCommand}" CommandParameter="{Binding Subscription}" CornerRadius="6" Background="#FFF3E0" Foreground="#E65100" FontSize="11" BorderThickness="0"/>
                          <Button Content="بروزرسانی" Padding="8,4" IsVisible="{Binding IsNotSubscription}" Command="{Binding Owner.UpdateGroupServersCommand}" CommandParameter="{Binding}" CornerRadius="6" Background="#FFF3E0" Foreground="#E65100" FontSize="11" BorderThickness="0"/>
                          <Button Content="حذف ساب" Padding="8,4" IsVisible="{Binding IsSubscription}" Command="{Binding Owner.RemoveSubscriptionCommand}" CommandParameter="{Binding Subscription}" CornerRadius="6" Background="#FFF5F5" Foreground="#E53E3E" FontSize="11" BorderThickness="0"/>
                          <Button Content="حذف همه" Padding="8,4" IsVisible="{Binding IsNotSubscription}" Command="{Binding Owner.RemoveGroupServersCommand}" CommandParameter="{Binding}" CornerRadius="6" Background="#FFF5F5" Foreground="#E53E3E" FontSize="11" BorderThickness="0"/>
                        </StackPanel>
                        <ComboBox Grid.Column="3" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding GroupSortField, Mode=TwoWay}" Width="110" Padding="4,3" FontSize="10" VerticalAlignment="Center"/>
                      </Grid>
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding Servers}" ItemTemplate="{StaticResource ServerRowTemplate}" Margin="0,0,0,0">
                      <ItemsControl.Styles>
                        <Style Selector="ContentPresenter">
                          <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        </Style>
                      </ItemsControl.Styles>
                    </ItemsControl>
                  </Expander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <!-- Subscriptions Tab -->
      <TabItem Header="اشتراک" Padding="16">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Text="{Binding SubName}" PlaceholderText="نام" Width="150" Padding="10,8" CornerRadius="6"/>
              <TextBox Text="{Binding SubUrl}" PlaceholderText="https://..." Width="400" Padding="10,8" CornerRadius="6"/>
              <Button Content="+ افزودن" Command="{Binding AddSubscriptionCommand}" Padding="16,8" CornerRadius="6" Background="{StaticResource PrimaryBrush}" Foreground="White"/>
            </StackPanel>
            <Button Content="🔄 بروزرسانی همه" Command="{Binding UpdateSubscriptionsCommand}" Padding="12,8" CornerRadius="6"/>
          </StackPanel>
          
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Subscriptions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="6" Padding="16" Margin="0,8,0,0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text="{Binding ServerCount, StringFormat='تعداد سرورها: {0}'}" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                      </StackPanel>
                      <Button Grid.Column="1" Content="🔄" Padding="8" Margin="12,0,0,0" Command="{Binding #RootWindow.DataContext.UpdateSingleSubscriptionCommand}" CommandParameter="{Binding}"/>
                      <Button Grid.Column="2" Content="🗑️" Padding="8" Margin="8,0,0,0" Command="{Binding #RootWindow.DataContext.RemoveSubscriptionCommand}" CommandParameter="{Binding}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <!-- Log Tab -->
      <TabItem Header="لاگ" Padding="16">
        <ScrollViewer>
          <TextBox Text="{Binding LogText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Background="#F5F5F5" BorderThickness="0"/>
        </ScrollViewer>
      </TabItem>

      <!-- Settings Tab -->
      <TabItem Header="⚙ تنظیمات" Padding="16">
        <ScrollViewer>
          <StackPanel Spacing="16">
            <Border CornerRadius="6" Padding="16" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="اتصال" FontWeight="Bold" FontSize="13"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox IsChecked="{Binding SetSystemProxy}" VerticalAlignment="Center"/>
                  <TextBlock Text="تنظیم پراکسی سیستم" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox IsChecked="{Binding AutoConnect}" VerticalAlignment="Center"/>
                  <TextBlock Text="اتصال خودکار" VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
            </Border>
            
            <Border CornerRadius="6" Padding="16" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="بروزرسانی خودکار اشتراک" FontWeight="Bold" FontSize="13"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox IsChecked="{Binding AutoUpdateSubs}" VerticalAlignment="Center"/>
                  <TextBlock Text="بروزرسانی خودکار اشتراک‌ها" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding AutoUpdateSubs}">
                  <TextBlock Text="هر" VerticalAlignment="Center"/>
                  <TextBox Text="{Binding AutoUpdateIntervalHours}" Width="60" Padding="6,4" HorizontalContentAlignment="Center"/>
                  <TextBlock Text="ساعت بروزرسانی شود" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding LastUpdateDisplay}" FontSize="11" Foreground="{StaticResource TextSecondary}" IsVisible="{Binding AutoUpdateSubs}"/>
              </StackPanel>
            </Border>

            <Border CornerRadius="6" Padding="16" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="تنظیمات پیشرفته" FontWeight="Bold" FontSize="13"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="نوع پینگ:" VerticalAlignment="Center"/>
                  <ComboBox ItemsSource="{Binding PingTypeOptions}" SelectedItem="{Binding SelectedPingType}" Width="160"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border CornerRadius="6" Padding="16" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="DNS سفارشی" FontWeight="Bold" FontSize="13"/>
                <Button Content="⚙  تنظیمات DNS" Padding="16,10" CornerRadius="8" Background="#0E7C6B" Foreground="White" FontSize="13" FontWeight="SemiBold" Command="{Binding OpenDnsSettingsCommand}"/>
              </StackPanel>
            </Border>

            <Border CornerRadius="6" Padding="16" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <ToggleSwitch IsChecked="{Binding UseTunMode}"/>
                  <TextBlock Text="حالت TUN (VPN کامل سیستم)" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="این حالت نیاز به دسترسی Administrator دارد و تمام ترافیک سیستم (نه فقط برنامه‌های سازگار با پروکسی) را از طریق تانل عبور می‌دهد" FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <TextBlock Text="Roxa 3.0 • Avalonia" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,16,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <!-- Toast Notification -->
    <Border x:Name="ToastBorder" IsVisible="False" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,80,0,0" ZIndex="100"
            Background="#122A25" CornerRadius="10" Padding="20,12" MaxWidth="400">
      <TextBlock x:Name="ToastText" Text="" FontSize="13" Foreground="White" TextWrapping="Wrap" TextAlignment="Center"/>
    </Border>
  </Grid>
</Window>
