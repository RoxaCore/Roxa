<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Roxa.Views.UpdatePromptWindow"
        Title="Roxa"
        Width="460" SizeToContent="Height" MaxHeight="420" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#F8F9FA">
  <!-- The every-10-days question: yes starts the update window, no (or the X)
       just records the answer and goes away. -->
  <StackPanel Margin="24" Spacing="14">
    <ScrollViewer MaxHeight="260">
      <StackPanel Spacing="10">
        <TextBlock x:Name="MessageText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="NotesText" FontSize="12" Foreground="#5C6E6A"
                   TextWrapping="Wrap" IsVisible="False"/>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
      <Button x:Name="YesBtn" Padding="18,6" FontSize="13"/>
      <Button x:Name="NoBtn" Padding="18,6" FontSize="13"/>
    </StackPanel>
  </StackPanel>
</Window>
