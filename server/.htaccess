Options -Indexes

# فایل‌های دادهٔ JSON باید از سمتِ وب قابلِ دسترسی نباشند — حتی اگر کسی
# DATA_DIR را دوباره داخلِ webroot برگردانده باشد. `.lock` و `.salt` هم همین‌طور؛
# `.salt` اگر لو برود، هش‌هایِ IP قابلِ برگشتِ آفلاین می‌شوند.
<FilesMatch "\.(json|lock|salt|tmp)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
